#!/usr/bin/env python3
"""Build global instructions and source provenance from an explicit catalog."""
import argparse
import base64
import datetime
import difflib
import functools
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
import subprocess
import sys
import tempfile
import tomllib
import uuid

CATALOG = 'instructions/assembly.toml'
ARTIFACT = 'instructions/AGENTS.md'
MANIFEST = 'instructions/AGENTS.manifest.json'
ASSEMBLER = 'bin/assemble-instructions'
START = '<!-- ops:projects start — generated by ops-projects; edit identity.toml in the project, or identity-mirror.toml in ops -->'
END = '<!-- ops:projects end -->'
FRAGMENT_FIELDS = {'id', 'owner', 'source', 'classification', 'rationale', 'provenance_date', 'evidence'}
EVIDENCE_FIELDS = {'owner', 'path', 'revision', 'location', 'status'}
EVIDENCE_LINES = 12


def git_run(root, *args, data=None):
    env = os.environ
    if root.resolve() != Path(__file__).resolve().parents[1]:
        # Hooks select lore's Git directory/index; foreign repositories must select their own.
        env = {key: value for key, value in env.items() if key not in local_env_names()}
    return subprocess.run(['git', '-C', str(root), *args], input=data, capture_output=True, env=env)


def git_bytes(root, *args, data=None):
    result = git_run(root, *args, data=data)
    if result.returncode:
        raise ValueError('git failed: ' + result.stderr.decode('utf-8', errors='replace').strip())
    return result.stdout


@functools.cache
def local_env_names():
    # The names depend on the Git binary, not the repository, so one answer serves the run.
    executing_root = Path(__file__).resolve().parents[1]
    return frozenset(git_bytes(executing_root, 'rev-parse', '--local-env-vars').decode().split())


def relative_path(path):
    if not isinstance(path, str) or not path or '\\' in path or '\0' in path:
        raise ValueError('source must be a nonempty owner-relative path')
    p = PurePosixPath(path)
    if p.is_absolute() or '..' in p.parts or str(p) != path:
        raise ValueError(f'source path escapes or is not canonical: {path}')
    return path


def contained(root, path):
    target = root / relative_path(path)
    if not target.resolve().is_relative_to(root.resolve()):
        raise ValueError(f'source leaves its owner checkout: {path}')
    return target


def read_local(root, path, *, index=False, revision=None):
    relative_path(path)
    if index and revision is not None:
        raise ValueError('choose one Git view')
    if index or revision is not None:
        return git_bytes(root, 'show', f'{"" if index else revision}:{path}')
    return contained(root, path).read_bytes()


def fields(value, expected, label):
    if not isinstance(value, dict) or set(value) != expected:
        raise ValueError(f'{label}: fields must be {", ".join(sorted(expected))}')


def text(value, label):
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f'{label} must be nonempty text')


def catalog_from(data):
    catalog = tomllib.loads(data.decode('utf-8'))
    fields(catalog, {'version', 'separator', 'fragments'}, 'catalog')
    if type(catalog['version']) is not int or catalog['version'] != 1 or catalog['separator'] != '\n':
        raise ValueError('catalog requires version 1 and a single newline separator')
    if not isinstance(catalog['fragments'], list) or not catalog['fragments']:
        raise ValueError('catalog must declare fragments')
    seen = set()
    for f in catalog['fragments']:
        fields(f, FRAGMENT_FIELDS, 'fragment')
        for key in ('id', 'owner', 'source', 'classification', 'rationale', 'provenance_date'):
            text(f[key], key)
        if not re.fullmatch(r'[a-z][a-z0-9-]*', f['id']) or f['id'] in seen:
            raise ValueError(f'duplicate or invalid fragment id: {f["id"]}')
        seen.add(f['id'])
        if not re.fullmatch(r'[a-z][a-z0-9]{1,7}', f['owner']):
            raise ValueError('invalid owner prefix')
        relative_path(f['source'])
        if f['classification'] not in ('mandatory', 'adaptable'):
            raise ValueError('classification must be mandatory or adaptable')
        if datetime.date.fromisoformat(f['provenance_date']).isoformat() != f['provenance_date']:
            raise ValueError('provenance date must be YYYY-MM-DD')
        if not isinstance(f['evidence'], list) or not f['evidence']:
            raise ValueError('explicit evidence is required')
        for evidence in f['evidence']:
            fields(evidence, EVIDENCE_FIELDS, 'evidence')
            for key in EVIDENCE_FIELDS:
                text(evidence[key], 'evidence ' + key)
            # PREFIX names a project's checkout; PREFIX:records its records directory.
            if not re.fullmatch(r'[a-z][a-z0-9]{1,7}(:records)?', evidence['owner']):
                raise ValueError('invalid evidence owner prefix')
            if evidence['status'] not in ('recorded', 'none recorded', 'n/a'):
                raise ValueError('evidence status must be recorded, none recorded or n/a')
            if evidence['path'] in ('none recorded', 'n/a') or evidence['revision'] in ('none recorded', 'n/a'):
                if evidence['path'] != evidence['revision']:
                    raise ValueError('evidence path and revision must use the same sentinel')
            if evidence['path'] not in ('none recorded', 'n/a'):
                relative_path(evidence['path'])
    return catalog


def digest(data):
    return hashlib.sha256(data).hexdigest()


def blob(data):
    # Git's SHA-1 object id for a blob; lore is a SHA-1 repository.
    return hashlib.sha1(b'blob %d\0' % len(data) + data).hexdigest()


# Rule identity and claims are data; validation never resolves external evidence.
RULE_ID = r'rule:[0-9a-f]{32}'
CLAUSE_ID = r'clause:[0-9a-f]{32}'
HASH = r'[0-9a-f]{64}'
RULE_DIR = 'instructions/rules'


def object_schema(**properties):
    return {'type': 'object', 'properties': properties, 'required': list(properties), 'additionalProperties': False}


def array_schema(items):
    return {'type': 'array', 'items': items}


def rule_schemas():
    string = {'type': 'string', 'minLength': 1}
    nullable = {'type': ['string', 'null']}
    digest_schema = {'type': 'string', 'pattern': '^' + HASH + '$'}
    rid = {'type': 'string', 'pattern': '^' + RULE_ID + '$'}
    cid = {'type': 'string', 'pattern': '^' + CLAUSE_ID + '$'}
    enum = lambda *values: {'enum': list(values)}
    ref = lambda name: {'$ref': '#/$defs/' + name}
    refs = array_schema(string)
    locator = object_schema(kind=enum('git', 'session', 'attachment', 'retained'), owner=nullable,
                            path=nullable, revision=nullable, reference=string)
    revision_subject = object_schema(binding=enum('revision'), id={'type': 'string', 'pattern': '^(' + RULE_ID + '|' + CLAUSE_ID + ')$'}, sha256=digest_schema)
    historical = object_schema(binding=enum('historical-excerpt'), id=revision_subject['properties']['id'], sha256={'anyOf': [digest_schema, {'type': 'null'}]},
                               source=string, excerpt_sha256=digest_schema, preservation=locator)
    target = {'anyOf': [revision_subject, object_schema(binding=enum('scope'), reference=string, revision=nullable, scope=string)]}
    unknown = object_schema(value=nullable, reason=nullable)
    instruction = object_schema(ref=string, owner=string, sha256={'anyOf': [digest_schema, {'type': 'null'}]}, reason=nullable)
    context = object_schema(name=string, model=unknown,
                            harness=object_schema(name=nullable, version=nullable, reason=nullable),
                            instructions=array_schema(instruction), environment={'type': 'object', 'additionalProperties': unknown})
    clause = object_schema(id=cid, text=string, offset={'type': 'integer', 'minimum': 0}, sha256=digest_schema,
                           parent_sha256=digest_schema, overlaps=array_schema(cid))
    defs = {
        'locator': locator, 'subject': revision_subject,
        'source': object_schema(id=string, locator=locator, source_time=nullable, inspected_at=nullable,
            access=enum('available', 'unavailable', 'not-checked'), representation=enum('raw', 'excerpt', 'portable-derivative'),
            sha256={'anyOf': [digest_schema, {'type': 'null'}]}, preservation={'anyOf': [locator, {'type': 'null'}]},
            raw_sha256={'anyOf': [digest_schema, {'type': 'null'}]}, transformation=nullable),
        'search': object_schema(id=string, scope=string, cutoff=string, exclusions=refs, recorder=string, unresolved=refs),
        'event': object_schema(id=string, subject={'anyOf': [revision_subject, historical]},
            kind=enum('appearance', 'proposal', 'correction', 'adoption', 'restatement', 'amendment', 'relocation', 'retirement'),
            occurred_at=nullable, time_uncertainty=nullable, recorded_at=string, recorder=string, predecessors=refs,
            claim=object_schema(authorship=object_schema(actor=enum('user', 'agent', 'unknown'), role=enum('goal', 'mechanism', 'wording'),
                statement=string, basis=enum('observed', 'inferred', 'unknown'), reason=nullable, supplier=nullable, original_author=nullable),
                adoption=object_schema(status=enum('accepted', 'restated', 'authorized-scope', 'inferred-only', 'none-recovered'),
                    actor=nullable, target={'anyOf': [target, {'type': 'null'}]}, evidence=refs, covers_clauses={'type': 'boolean'}),
                evidence_quality=array_schema(object_schema(source=string, quality=enum('originating-request/proposal', 'first-known-appearance', 'later-restatement', 'unknown')))),
            evidence=refs, searches=refs),
        'context': context,
    }
    assessment = object_schema(schema=enum(1), id=string, kind=enum('approval', 'applicability', 'effectiveness'), subject=revision_subject,
        question=string, assessor=object_schema(label=string, session=nullable), recorded_at=string, evidence=refs,
        context=ref('context'), instruction_dependencies=object_schema(items=array_schema(object_schema(ref=string, sha256=digest_schema)), rationale=nullable),
        result={'type': 'object'}, limitations=refs, supersedes=refs)
    results = {
        'approval': object_schema(verdict=enum('accepted', 'rejected', 'authorized-scope'), authority=string, target=target),
        'applicability': object_schema(verdict=enum('applicable', 'not-applicable', 'uncertain'), goal=string, conditions=string, rationale=string),
        'effectiveness': object_schema(mode=enum('observation', 'experiment'), procedure=string,
            cases=array_schema(object_schema(id=string, inputs={'type': 'object', 'additionalProperties': digest_schema},
                observations=string, count={'type': ['number', 'null']}, unit=nullable, selected_at=string, executed_at=string, intervention=string)),
            comparator=nullable, outcome=string, limitations=refs),
    }
    defs['assessment'] = {'anyOf': [dict(assessment, properties=dict(assessment['properties'], kind=enum(kind), result=result)) for kind, result in results.items()]}
    rule = object_schema(schema=enum(1), id=rid, title=string, state=enum('active', 'retired'),
        purpose=object_schema(text=string, basis=enum('observed', 'inferred', 'unknown'), sources=refs),
        impact=object_schema(tier=enum('high', 'work', 'low', 'unknown'), categories=refs, reason=string),
        relations=array_schema(object_schema(kind=enum('split_from', 'merged_from'), targets=array_schema(rid))),
        revisions=array_schema(object_schema(sha256=digest_schema, text=string, locator={'anyOf': [locator, {'type': 'null'}]}, clauses=array_schema(clause))),
        events=array_schema(ref('event')), incidents=array_schema(object_schema(id=string, subject=revision_subject,
            status=enum('recorded', 'none recorded', 'n/a'), rationale=string, evidence=refs)),
        assessments=array_schema(ref('assessment')), sources=array_schema(ref('source')), searches=array_schema(ref('search')))
    rule['$defs'] = defs
    exclusions = object_schema(schema=enum(1), fragment=string, entries=array_schema(object_schema(text=string, reason=string)))
    context = dict(context, properties=dict(context['properties'], schema=enum(1)), required=context['required'] + ['schema'])
    return {'rule': rule, 'exclusions': exclusions, 'context': context}


def validate_schema(value, schema, label, definitions=None):
    definitions = schema.get('$defs', definitions or {})
    if '$ref' in schema:
        return validate_schema(value, definitions[schema['$ref'].split('/')[-1]], label, definitions)
    if 'anyOf' in schema:
        for option in schema['anyOf']:
            try:
                validate_schema(value, option, label, definitions)
                return
            except ValueError:
                pass
        raise ValueError(f'{label}: invalid variant')
    if 'enum' in schema and not any(type(value) is type(v) and value == v for v in schema['enum']):
        raise ValueError(f'{label}: expected one of {schema["enum"]}')
    types = {'object': dict, 'array': list, 'string': str, 'integer': int, 'number': (int, float), 'boolean': bool, 'null': type(None)}
    expected = schema.get('type', list(types))
    if isinstance(expected, str): expected = [expected]
    if not any(type(value) in (types[t] if isinstance(types[t], tuple) else (types[t],)) for t in expected): raise ValueError(f'{label}: wrong type')
    if isinstance(value, str):
        if len(value) < schema.get('minLength', 0) or ('pattern' in schema and not re.fullmatch(schema['pattern'], value)):
            raise ValueError(f'{label}: invalid text')
    if type(value) is int and value < schema.get('minimum', value): raise ValueError(f'{label}: below minimum')
    if isinstance(value, dict):
        props = schema.get('properties', {})
        if set(schema.get('required', [])) - value.keys(): raise ValueError(f'{label}: missing fields')
        extra = schema.get('additionalProperties', True)
        if extra is False and value.keys() - props.keys(): raise ValueError(f'{label}: unknown fields')
        for key, item in value.items():
            child = props.get(key, extra)
            if isinstance(child, dict): validate_schema(item, child, f'{label}.{key}', definitions)
    if isinstance(value, list):
        for i, item in enumerate(value): validate_schema(item, schema['items'], f'{label}[{i}]', definitions)


def scan_rules(data):
    data.decode('utf-8')
    if not data.endswith(b'\n') or data.endswith(b'\n\n'): raise ValueError('raw fragment requires one trailing newline')
    output, rules, uncovered, pending = bytearray(), [], [], []
    active, content, start, fence, seen = None, bytearray(), 0, None, set()
    def flush():
        if pending:
            uncovered.append({'text': b''.join(x[1] for x in pending).decode(), 'start_line': pending[0][0], 'end_line': pending[-1][0]})
            pending.clear()
    for number, line in enumerate(data.splitlines(keepends=True), 1):
        marker = re.fullmatch(rb'<!-- (rule:[0-9a-f]{32}) (begin|end) -->\n', line)
        if b'<!-- rule:' in line:
            if not marker or fence: raise ValueError(f'invalid rule marker at line {number}')
            rid, action = (v.decode() for v in marker.groups())
            flush()
            if action == 'begin':
                if active or rid in seen: raise ValueError(f'duplicate or nested rule {rid}')
                active, content, start = rid, bytearray(), len(output)
                seen.add(rid)
            else:
                if active != rid or not content: raise ValueError(f'unmatched or empty rule {rid}')
                raw = bytes(content)
                rules.append(dict(id=rid, text=raw.decode(), sha256=digest(raw), offset=start, length=len(raw)))
                active = None
            continue
        is_open = re.match(rb' {0,3}(`{3,}|~{3,})(.*)\n$', line)
        was_fenced = fence is not None
        if fence:
            if re.fullmatch(rb' {0,3}' + re.escape(fence[:1]) + rb'{' + str(len(fence)).encode() + rb',}[ \t]*\n', line): fence = None
        elif is_open:
            fence = is_open.group(1)
        output.extend(line)
        if active:
            content.extend(line)
        elif not (was_fenced or fence) and (not line.strip() or re.match(rb' {0,3}#{1,6}(?:[ \t]|\n)', line)):
            flush()
        else:
            pending.append((number, line))
    flush()
    if active or fence: raise ValueError('unclosed rule or code fence')
    rendered = bytes(output)
    if not rendered.endswith(b'\n') or rendered.endswith(b'\n\n'): raise ValueError('rendered fragment requires one trailing newline')
    return dict(rendered=rendered, rules=rules, uncovered=uncovered)


def new_rule_record(rule_id, title, data):
    return dict(schema=1, id=rule_id, title=title, state='active',
        purpose=dict(text='Purpose not yet recorded.', basis='unknown', sources=[]),
        impact=dict(tier='unknown', categories=[], reason='Classification not yet reviewed.'), relations=[],
        revisions=[dict(sha256=digest(data), text=data.decode('utf-8'), locator=None, clauses=[])],
        events=[], incidents=[], assessments=[], sources=[], searches=[])


def subject_bytes(record, subject):
    for revision in record['revisions']:
        if subject['id'] == record['id'] and subject['sha256'] == revision['sha256']: return revision['text'].encode()
        for clause in revision['clauses']:
            if subject['id'] == clause['id'] and subject['sha256'] == clause['sha256']: return clause['text'].encode()
    raise ValueError(f'{record["id"]}: subject revision not retained')


def validate_locator(locator):
    if locator is None: return
    if locator['path'] is not None: relative_path(locator['path'])
    if locator['kind'] == 'git' and (not locator['owner'] or not locator['path'] or (locator['revision'] is not None and not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', locator['revision']))):
        raise ValueError('git locator requires owner/path/full commit')


def reference_identity(owner, ref):
    return tuple(ref.split('#', 1)) if '#' in ref else (owner, ref)


def validate_supersession(records, *, allow_external=False):
    assessments = {(owner, a['id']): a for owner, r in records.items() for a in r['assessments']}
    completed = set()
    def visit(identity, path):
        if identity in path: raise ValueError('assessment supersession cycle')
        if identity in completed: return
        a = assessments[identity]
        for ref in a['supersedes']:
            target = reference_identity(identity[0], ref)
            if allow_external and target[0] not in records: continue
            if target not in assessments: raise ValueError('dangling assessment reference')
            other = assessments[target]
            if other['kind'] != a['kind'] or other['subject']['id'] != a['subject']['id']:
                raise ValueError('superseding assessment must address the same kind and subject')
            visit(target, path | {identity})
        completed.add(identity)
    for identity in assessments: visit(identity, set())


def validate_rule(record):
    validate_schema(record, rule_schemas()['rule'], 'rule')
    label = record['id']
    if not record['revisions']: raise ValueError(f'{label}: no revisions')
    seen = set()
    for rev in record['revisions']:
        data = rev['text'].encode()
        if digest(data) != rev['sha256'] or rev['sha256'] in seen: raise ValueError(f'{label}: duplicate or incorrect revision hash')
        seen.add(rev['sha256'])
        validate_locator(rev['locator'])
        ids = {c['id'] for c in rev['clauses']}
        if len(ids) != len(rev['clauses']): raise ValueError(f'{label}: duplicate clause')
        for c in rev['clauses']:
            quote = c['text'].encode()
            if c['parent_sha256'] != rev['sha256'] or digest(quote) != c['sha256'] or data[c['offset']:c['offset'] + len(quote)] != quote:
                raise ValueError(f'{label}: stale clause selector')
            if set(c['overlaps']) - ids or c['id'] in c['overlaps']: raise ValueError('invalid clause overlaps')
            for other in rev['clauses']:
                if c['id'] != other['id'] and max(c['offset'], other['offset']) < min(c['offset'] + len(quote), other['offset'] + len(other['text'].encode())):
                    if other['id'] not in c['overlaps']: raise ValueError('undeclared clause overlap')
    groups = {k: {v['id']: v for v in record[k]} for k in ('events', 'sources', 'searches', 'assessments', 'incidents')}
    for group, entries in groups.items():
        if len(entries) != len(record[group]): raise ValueError(f'{label}: duplicate {group} id')
    def references(values, group):
        for value in values:
            owner, local = reference_identity(label, value)
            if owner == label and local not in groups[group]: raise ValueError(f'{label}: dangling {group} reference')
    references(record['purpose']['sources'], 'sources')
    for source in record['sources']:
        validate_locator(source['locator']); validate_locator(source['preservation'])
        if source['representation'] == 'portable-derivative' and not source['transformation']: raise ValueError('derivative needs transformation')
        if source['sha256'] and not source['preservation']: raise ValueError('held bytes need preservation locator')
    for item in record['events'] + record['incidents'] + record['assessments']:
        subject = item['subject']
        if subject['binding'] == 'revision': subject_bytes(record, subject)
        else:
            references([subject['source']], 'sources'); validate_locator(subject['preservation'])
        references(item['evidence'], 'sources')
    for event in record['events']:
        references(event['predecessors'], 'events'); references(event['searches'], 'searches')
        if event['occurred_at'] is None and not event['time_uncertainty']: raise ValueError('unknown event time needs explanation')
        authorship = event['claim']['authorship']
        if authorship['basis'] == 'inferred' and not authorship['reason']: raise ValueError('inference needs reason')
        adoption = event['claim']['adoption']
        if event['subject']['binding'] == 'historical-excerpt' and adoption['target'] and adoption['target']['binding'] == 'revision':
            raise ValueError('historical excerpt cannot assert exact revision adoption')
        references(adoption['evidence'], 'sources')
        references([q['source'] for q in event['claim']['evidence_quality']], 'sources')
        if adoption['status'] in ('accepted', 'restated'):
            if not adoption['actor'] or not adoption['target'] or not adoption['evidence']: raise ValueError('adoption needs actor, target and evidence')
            if adoption['target']['binding'] == 'revision': subject_bytes(record, adoption['target'])
    for a in record['assessments']:
        references(a['supersedes'], 'assessments')
        validate_context(a['context'], external=False)
        dependencies = a['instruction_dependencies']
        if dependencies['items'] and not dependencies['rationale']: raise ValueError('dependencies need rationale')
        dependent_ids = [d['ref'] for d in dependencies['items']]
        if len(dependent_ids) != len(set(dependent_ids)): raise ValueError('duplicate instruction dependency')
        forbidden = {a['subject']['id'], record['id'], ARTIFACT}
        if a['subject']['id'] == record['id']: forbidden |= {c['id'] for rev in record['revisions'] for c in rev['clauses']}
        if any(d['ref'] in forbidden for d in dependencies['items']): raise ValueError('subject cannot be its own surrounding dependency')
        result = a['result']
        if a['kind'] == 'approval':
            fields(result, {'verdict', 'authority', 'target'}, 'approval result')
            if result['verdict'] not in ('accepted', 'rejected', 'authorized-scope'): raise ValueError('invalid approval verdict')
            text(result['authority'], 'approval authority')
            validate_schema(result['target'], rule_schemas()['rule']['$defs']['event']['properties']['claim']['properties']['adoption']['properties']['target'], 'approval target')
        elif a['kind'] == 'applicability':
            fields(result, {'verdict', 'goal', 'conditions', 'rationale'}, 'applicability result')
            if result['verdict'] not in ('applicable', 'not-applicable', 'uncertain'): raise ValueError('invalid applicability verdict')
            for key in ('goal', 'conditions', 'rationale'): text(result[key], key)
        else:
            fields(result, {'mode', 'procedure', 'cases', 'comparator', 'outcome', 'limitations'}, 'effectiveness result')
            if result['mode'] not in ('observation', 'experiment'): raise ValueError('invalid effectiveness mode')
            for key in ('procedure', 'outcome'): text(result[key], key)
            if not isinstance(result['cases'], list) or not result['cases']: raise ValueError('effectiveness needs cases')
            for case in result['cases']:
                fields(case, {'id', 'inputs', 'observations', 'count', 'unit', 'selected_at', 'executed_at', 'intervention'}, 'case')
                for key in ('id', 'observations', 'selected_at', 'executed_at', 'intervention'): text(case[key], key)
                if not isinstance(case['inputs'], dict) or any(not re.fullmatch(HASH, v) for v in case['inputs'].values()): raise ValueError('case input hashes invalid')
                if case['count'] is not None and (type(case['count']) not in (int, float) or not case['unit']): raise ValueError('measured case needs count and unit')
    validate_supersession({label: record}, allow_external=True)


def validate_context(context, *, external=True):
    schema = rule_schemas()['context'] if external else rule_schemas()['rule']['$defs']['context']
    validate_schema(context, schema, 'context')
    if context['model']['value'] is None and not context['model']['reason']: raise ValueError('unknown model needs reason')
    if (context['harness']['name'] is None or context['harness']['version'] is None) and not context['harness']['reason']: raise ValueError('unknown harness needs reason')
    refs = [i['ref'] for i in context['instructions']]
    if len(refs) != len(set(refs)): raise ValueError('duplicate context instruction')
    for item in context['instructions']:
        if item['sha256'] is None and not item['reason']: raise ValueError('unknown instruction hash needs reason')
    for item in context['environment'].values():
        if item['value'] is None and not item['reason']: raise ValueError('unknown environment value needs reason')


def validate_rule_set(records, scans, exclusions):
    live = {}
    for fragment, scan in scans.items():
        for rule in scan['rules']:
            if rule['id'] in live: raise ValueError('duplicate rule across fragments')
            live[rule['id']] = dict(rule, source=scan.get('source', fragment))
        blocks = [b['text'] for b in scan['uncovered']]
        entries = exclusions.get(fragment, [])
        for entry in entries:
            fields(entry, {'text', 'reason'}, 'exclusion'); text(entry['reason'], 'exclusion reason')
        selected = [e['text'] for e in entries]
        if len(selected) != len(set(selected)) or any(blocks.count(v) != 1 for v in selected) or set(blocks) != set(selected):
            missing = [b for b in scan['uncovered'] if b['text'] not in selected]
            location = ', '.join(f'lines {b["start_line"]}-{b["end_line"]}' for b in missing) or 'duplicate/unused exclusion'
            raise ValueError(f'{fragment}: uncovered block ({location}); use add-rule for obligations or an exclusion entry for connective prose')
    if set(exclusions) - set(scans): raise ValueError('unused fragment exclusions')
    for key, record in records.items():
        validate_rule(record)
        if key != record['id']: raise ValueError('record filename/id mismatch')
        if (key in live) != (record['state'] == 'active'): raise ValueError('active/retired rule coverage mismatch')
        if key in live and not any(r['sha256'] == live[key]['sha256'] and r['text'] == live[key]['text'] for r in record['revisions']): raise ValueError(f'stale rule record: {live[key]["source"]}, {record_path(key)}; unstage these files keeping working edits, refresh, inspect and restage, then rerun check')
        for relation in record['relations']:
            if not relation['targets'] or any(t not in records or t == key for t in relation['targets']): raise ValueError('dangling rule relation')
    if set(live) - set(records): raise ValueError('marked rule missing record')
    # Qualified references remain explicit and are checked against the selected set.
    for record in records.values():
        def walk(value):
            if isinstance(value, dict):
                for key, child in value.items():
                    if key == 'source' and isinstance(child, str) and '#' in child:
                        owner, local = reference_identity(record['id'], child)
                        if owner not in records or not any(v['id'] == local for v in records[owner]['sources']): raise ValueError('dangling cross-rule source reference')
                    if key in ('evidence', 'sources', 'searches', 'predecessors', 'supersedes') and isinstance(child, list):
                        group = {'evidence': 'sources', 'predecessors': 'events', 'supersedes': 'assessments'}.get(key, key)
                        for ref in child:
                            if isinstance(ref, str) and '#' in ref:
                                owner, local = ref.split('#', 1)
                                if owner not in records or not any(v['id'] == local for v in records[owner][group]): raise ValueError('dangling cross-rule reference')
                    walk(child)
            elif isinstance(value, list):
                for child in value: walk(child)
        walk(record)
    validate_supersession(records)


def read_rule_set(root, *, index=False, revision=None):
    if index and revision is not None: raise ValueError('choose one Git view')
    if index:
        paths = git_bytes(root, 'ls-files', '-z', '--', RULE_DIR).decode().split('\0')
    elif revision:
        paths = git_bytes(root, 'ls-tree', '-r', '--name-only', '-z', revision, '--', RULE_DIR).decode().split('\0')
    else:
        directory = contained(root, RULE_DIR)
        paths = [p.relative_to(root).as_posix() for p in directory.glob('*.json')]
    records = {}
    for path in paths:
        if not path or '/exclusions/' in path: continue
        match = re.fullmatch(RULE_DIR + r'/([0-9a-f]{32})\.json', path)
        if not match: raise ValueError('invalid rule record path')
        record = json.loads(read_local(root, path, index=index, revision=revision))
        rid = 'rule:' + match[1]
        if record.get('id') != rid: raise ValueError('record filename/id mismatch')
        validate_rule(record)
        records[rid] = record
    return records


def record_path(rid):
    if not re.fullmatch(RULE_ID, rid): raise ValueError('invalid rule ID')
    return f'{RULE_DIR}/{rid[5:]}.json'


def local_scans(root, *, index=False, revision=None):
    catalog = catalog_from(read_local(root, CATALOG, index=index, revision=revision))
    paths = {f['id']: f['source'] for f in catalog['fragments'] if f['owner'] == 'lore'}
    return paths, {key: dict(scan_rules(read_local(root, path, index=index, revision=revision)), source=path) for key, path in paths.items()}


def refuse_staged(root, paths):
    staged = git_bytes(root, 'diff', '--cached', '--name-only', '--no-renames', '-z', '--', *sorted(paths)).decode().split('\0')
    staged = [p for p in staged if p]
    if staged:
        raise ValueError('staged inputs: ' + ', '.join(staged) + '; unstage these files keeping working edits, refresh, inspect, restage and rerun check')


def write_files(root, values):
    # Preflight every destination before replacing any file; interrupted sets are resumable.
    outputs = [(output_path(root, name), data) for name, data in values]
    written, pending = [], [name for name, _ in values]
    try:
        for path, data in outputs:
            name = path.relative_to(root).as_posix()
            if not path.exists() or path.read_bytes() != data:
                path.parent.mkdir(parents=True, exist_ok=True)
                temporary = None
                try:
                    with tempfile.NamedTemporaryFile(dir=path.parent, prefix='.' + path.name + '-', delete=False) as stream:
                        temporary = Path(stream.name)
                        stream.write(data)
                        os.fchmod(stream.fileno(), stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644)
                    output_path(root, name)
                    os.replace(temporary, path)
                finally:
                    if temporary: temporary.unlink(missing_ok=True)
            written.append(name); pending.remove(name)
    except OSError as error:
        raise ValueError(f'{error}; written: {written}; unwritten: {pending}; retry the same operation/ID') from error
    return written


def committed_record(root, rid):
    return bool(git_bytes(root, 'log', '--all', '-1', '--format=%H', '--', record_path(rid)).strip())


def check_authoring_set(records, scans):
    # Creating one range must work while other prose is still awaiting annotation.
    # The assembly/check gate separately requires complete exclusion coverage.
    validate_rule_set(records, {f: dict(s, uncovered=[]) for f, s in scans.items()}, {})


def add_rule(root, args):
    paths, scans = local_scans(root)
    if args.fragment not in paths: raise ValueError('add-rule requires a local catalog fragment')
    source = paths[args.fragment]
    output_path(root, source)
    if args.start_line < 1 or args.end_line < args.start_line: raise ValueError('invalid inclusive source range')
    records = read_rule_set(root)
    targets = [args.split_from] if args.split_from else args.merged_from or []
    if len(targets) != len(set(targets)) or any(t not in records for t in targets): raise ValueError('unknown or duplicate predecessor rule')
    relations = [{'kind': 'split_from' if args.split_from else 'merged_from', 'targets': targets}] if targets else []
    rid = args.resume or 'rule:' + uuid.uuid4().hex
    destination = record_path(rid)
    pending_path = f'{RULE_DIR}/pending/{rid[5:]}.json'
    for path in (destination, pending_path): output_path(root, path)
    refuse_staged(root, [source, destination, pending_path])
    if rid not in records and committed_record(root, rid): raise ValueError('missing committed record is corruption; restore retained history')
    print(rid, flush=True)
    request = dict(fragment=args.fragment, start_line=args.start_line, end_line=args.end_line, title=args.title, relations=relations)
    data = read_local(root, source)
    journal = contained(root, pending_path)
    if journal.exists():
        saved = json.loads(journal.read_bytes())
        fields(saved, {'request', 'before', 'after', 'record'}, 'pending creation')
        if not args.resume or saved['request'] != request: raise ValueError('resume request differs from pending creation')
        proposed = saved['after'].encode()
        proposed_scan = scan_rules(proposed)
        rule = next((r for r in proposed_scan['rules'] if r['id'] == rid), None)
        if rule is None: raise ValueError('pending creation has no matching identity')
        expected = new_rule_record(rid, args.title, rule['text'].encode()); expected['relations'] = relations
        if saved['record'] != expected: raise ValueError('pending record differs from attempted creation')
        if data != proposed and digest(data) != saved['before']: raise ValueError('source differs from interrupted creation; inspect before resuming')
        record = saved['record']
    else:
        lines = data.splitlines(keepends=True)
        begin, end = args.start_line - 1, args.end_line
        existing = next((r for r in scans[args.fragment]['rules'] if r['id'] == rid), None)
        if existing:
            # An already complete retry must match its retained creation exactly.
            marker = f'<!-- {rid} begin -->\n'.encode()
            if not args.resume or begin >= len(lines) or lines[begin] != marker: raise ValueError('resume range does not match existing rule')
            selected = b''.join(lines[begin + 1:end + 1])
            if selected.decode() != existing['text']: raise ValueError('resume range differs')
            proposed = data
        else:
            if end > len(lines): raise ValueError('source range exceeds fragment')
            selected = b''.join(lines[begin:end])
            proposed = b''.join(lines[:begin]) + f'<!-- {rid} begin -->\n'.encode() + selected + f'<!-- {rid} end -->\n'.encode() + b''.join(lines[end:])
        record = new_rule_record(rid, args.title, selected); record['relations'] = relations
        proposed_scan = scan_rules(proposed)  # Reject nesting, fences and invalid newline boundaries.
        saved = dict(request=request, before=digest(data), after=proposed.decode(), record=record)
    if rid in records and records[rid] != record: raise ValueError('existing record differs; never overwrite retained history')
    proposed_records = dict(records, **{rid: record})
    check_authoring_set(proposed_records, dict(scans, **{args.fragment: proposed_scan}))
    # Recovery metadata is local authoring state, never part of delivery or evidence.
    written = write_files(root, [(pending_path, manifest_bytes(saved)), (source, proposed), (destination, manifest_bytes(record))])
    journal.unlink()
    print('written: ' + ', '.join(written) + '; command execution does not imply adoption')
    return rid


def refresh_rule(record, data, replacements):
    validate_rule(record)
    sha = digest(data)
    retained = next((r for r in record['revisions'] if r['sha256'] == sha), None)
    if retained:
        current = {c['id']: c for c in retained['clauses']}
        historic = {c['id'] for r in record['revisions'] for c in r['clauses']}
        for cid, change in replacements.items():
            if change == {'retire': True} and cid in historic and cid not in current: continue
            if cid not in current or change != {k: current[cid][k] for k in ('text', 'offset')}:
                raise ValueError('cannot replace selectors on a retained revision')
        updated = json.loads(json.dumps(record))
        # Order records the last explicit refresh, not event chronology. Rendering
        # still resolves the active revision by the current source hash.
        updated['revisions'] = [r for r in updated['revisions'] if r['sha256'] != sha] + [json.loads(json.dumps(retained))]
        return updated
    old = record['revisions'][-1]
    if set(replacements) - {c['id'] for c in old['clauses']}: raise ValueError('selector does not name a current clause')
    clauses = []
    for old_clause in old['clauses']:
        clause = dict(old_clause)
        change = replacements.get(clause['id'])
        if change is not None:
            if change == {'retire': True}: continue
            fields(change, {'text', 'offset'}, 'selector')
            if type(change['offset']) is not int or change['offset'] < 0: raise ValueError('invalid selector offset')
            text(change['text'], 'selector quote')
            clause.update(change)
        else:
            quote = clause['text'].encode()
            matches = [m.start() for m in re.finditer(b'(?=' + re.escape(quote) + b')', data)]
            if len(matches) != 1: raise ValueError(f'{clause["id"]}: {len(matches)} matches; supply explicit selector or retirement and rerun refresh')
            clause['offset'] = matches[0]
        clause.update(sha256=digest(clause['text'].encode()), parent_sha256=sha)
        clauses.append(clause)
    retained_ids = {c['id'] for c in clauses}
    for clause in clauses: clause['overlaps'] = [i for i in clause['overlaps'] if i in retained_ids]
    updated = json.loads(json.dumps(record))
    updated['revisions'].append(dict(sha256=sha, text=data.decode('utf-8'), locator=None, clauses=clauses))
    validate_rule(updated)
    return updated


def refresh(root, args):
    paths, scans = local_scans(root)
    records = read_rule_set(root)
    live = {r['id']: (f, r) for f, scan in scans.items() for r in scan['rules']}
    for rid in live.keys() - records.keys():
        if committed_record(root, rid): raise ValueError('missing committed record is corruption; restore retained history: ' + record_path(rid))
        raise ValueError('marked rule missing record; resume its add-rule operation: ' + rid)
    selected = set(args.rules) if args.rules else {rid for rid, (_, r) in live.items() if records[rid]['revisions'][-1]['sha256'] != r['sha256']}
    if selected - live.keys(): raise ValueError('refresh requires live rule IDs')
    replacements = json.loads(Path(args.selectors).read_bytes()) if args.selectors else {}
    if not isinstance(replacements, dict): raise ValueError('selectors must be an object')
    if not args.rules:
        selected |= {rid for rid in live if any(c['id'] in replacements for r in records[rid]['revisions'] for c in r['clauses'])}
    known = {c['id'] for rid in selected for r in records[rid]['revisions'] for c in r['clauses']}
    if replacements.keys() - known: raise ValueError('selector not in selected rules')
    affected = {p for rid in selected for p in (paths[live[rid][0]], record_path(rid))}
    refuse_staged(root, affected)
    for path in affected: output_path(root, path)
    proposed = dict(records)
    for rid in sorted(selected):
        ids = {c['id'] for r in records[rid]['revisions'] for c in r['clauses']}
        proposed[rid] = refresh_rule(records[rid], live[rid][1]['text'].encode(), {c: v for c, v in replacements.items() if c in ids})
    check_authoring_set(proposed, scans)
    written = write_files(root, [(record_path(rid), manifest_bytes(proposed[rid])) for rid in sorted(selected) if proposed[rid] != records[rid]])
    print('refreshed: ' + (', '.join(sorted(selected)) or 'none') + '; written: ' + ', '.join(written))


TIERS = ('high', 'work', 'low', 'unknown')
WARNING_KINDS = ('unknown-origin', 'uncertain-applicability', 'untested-effectiveness',
                 'stale-assessment', 'currency-unverifiable', 'unassessed-context-drift')


def unknown_context():
    return dict(schema=1, name='unspecified', model=dict(value=None, reason='No context supplied.'),
                harness=dict(name=None, version=None, reason='No context supplied.'), instructions=[], environment={})


def current_subjects(records, scans):
    subjects = {}
    for scan in scans.values():
        for rule in scan['rules']:
            record = records[rule['id']]
            revision = next(r for r in record['revisions'] if r['sha256'] == rule['sha256'])
            subjects[rule['id']] = dict(id=rule['id'], sha256=rule['sha256'], parent=rule['id'])
            for c in revision['clauses']:
                if c['id'] in subjects: raise ValueError('clause identity belongs to multiple current rules')
                subjects[c['id']] = dict(id=c['id'], sha256=c['sha256'], parent=rule['id'])
    return subjects


def snapshot_issues(context, available, known_local):
    issues = []
    for item in context['instructions']:
        ref = item['ref']
        local = ref in known_local or (item['owner'] == 'lore' and ref.startswith(('rule:', 'clause:', 'fragment:')))
        if local and ref not in available: issues.append('local instruction unavailable: ' + ref)
        elif ref in available and item['sha256'] != available[ref]: issues.append('snapshot mismatch: ' + ref)
    return issues


def compare_assessment(a, subject, target, available, known_local):
    changed, unknown, drift = [], [], []
    def compare(name, old, new):
        if old is None or new is None: unknown.append(name)
        elif old != new: changed.append(name)
    compare('subject.sha256', a['subject']['sha256'], subject['sha256'])
    observed = a['context']
    compare('model', observed['model']['value'], target['model']['value'])
    for key in ('name', 'version'): compare('harness.' + key, observed['harness'][key], target['harness'][key])
    supplied = {i['ref']: i['sha256'] for i in target['instructions']}
    prior = {i['ref']: i['sha256'] for i in observed['instructions']}
    # A snapshot is evidence of supplied context, not permission to replace local bytes.
    unknown.extend(snapshot_issues(target, available, known_local))
    if subject['id'] not in supplied:
        # Clauses may be delivered only as part of their container.
        if subject['parent'] not in supplied: unknown.append('subject delivery snapshot')
    dependencies = a['instruction_dependencies']
    if not dependencies['rationale']: unknown.append('instruction dependency declaration')
    refs = [i['ref'] for i in dependencies['items']]
    if [r for r in prior if r in refs] != refs: unknown.append('assessment dependency order')
    for item in dependencies['items']:
        ref = item['ref']
        compare('instruction:' + ref, item['sha256'], supplied.get(ref))
        if prior.get(ref) != item['sha256']: unknown.append('assessment dependency snapshot: ' + ref)
    if [r for r in supplied if r in refs] != refs:
        if set(refs) <= supplied.keys(): changed.append('instruction dependency order')
        else: unknown.append('instruction dependency order')
    def relevant_order(snapshot):
        anchor = subject['id'] if subject['id'] in snapshot else subject['parent']
        if anchor not in snapshot: return None
        return [subject['id'] if ref == anchor else ref for ref in snapshot if ref == anchor or ref in refs]
    compare('subject and dependency order', relevant_order(prior), relevant_order(supplied))
    for field, value in observed['environment'].items():
        compare('environment.' + field, value['value'], target['environment'].get(field, {}).get('value'))
    for ref in sorted(prior.keys() | supplied.keys()):
        if ref not in refs and ref not in (subject['id'], subject['parent']) and prior.get(ref) != supplied.get(ref): drift.append('instruction:' + ref)
    return dict(changed=sorted(set(changed)), unknown=sorted(set(unknown)), drift=drift)


def origin_state(record, subject, subjects):
    historic = False
    adopted = False
    for event in record['events']:
        bound = event['subject']
        if bound['id'] == subject['id']:
            author = event['claim']['authorship']
            if author['actor'] != 'unknown' and author['basis'] != 'unknown' and event['evidence'] and any(q['quality'] == 'originating-request/proposal' for q in event['claim']['evidence_quality']): historic = True
        adoption = event['claim']['adoption']
        target = adoption['target']
        if adoption['status'] not in ('accepted', 'restated') or adoption['actor'] not in ('human', 'user') or not adoption['evidence'] or not target or target['binding'] != 'revision': continue
        if target['id'] == subject['id'] and target['sha256'] == subject['sha256']: adopted = True
        if subject['id'] != subject['parent'] and adoption['covers_clauses'] and target['id'] == subject['parent'] and target['sha256'] == subjects[subject['parent']]['sha256']: adopted = True
    return dict(subject=subject['id'], historic_authorship='recorded' if historic else 'unknown', current_adoption=adopted,
                origin='reaffirmed-current' if adopted and not historic else 'recorded' if adopted and historic else 'unresolved')


def assess_rules(records, contexts, scans):
    for record in records.values(): validate_rule(record)
    contexts = contexts or [unknown_context()]
    for context in contexts: validate_context(context)
    if len({c['name'] for c in contexts}) != len(contexts): raise ValueError('context names must be unique')
    subjects = current_subjects(records, scans)
    available = {sid: subject['sha256'] for sid, subject in subjects.items()}
    available.update({'fragment:' + name: digest(scan['rendered']) for name, scan in scans.items()})
    known_local = set(records) | {c['id'] for r in records.values() for rev in r['revisions'] for c in rev['clauses']}
    judgments_by_subject = {}
    for rid, record in records.items():
        for a in record['assessments']:
            judgments_by_subject.setdefault(a['subject']['id'], []).append((rid, a))
    report = dict(schema=1, coverage=dict(rules=sum(s['id'] == s['parent'] for s in subjects.values()),
        clauses=sum(s['id'] != s['parent'] for s in subjects.values()), retired=sum(r['state'] == 'retired' for r in records.values()),
        tiers={tier: sum(r['state'] == 'active' and r['impact']['tier'] == tier for r in records.values()) for tier in TIERS}), contexts=[], findings=[], history=[])
    origins = {sid: origin_state(records[s['parent']], s, subjects) for sid, s in subjects.items()}
    for rid, record in sorted(records.items()):
        report['history'].append(dict(id=rid, title=record['title'], state=record['state'], subjects=[origins[s] for s in sorted(origins) if subjects[s]['parent'] == rid],
            purpose=record['purpose'], impact=record['impact'], relations=record['relations'], revisions=record['revisions'],
            events=record['events'], incidents=record['incidents'], assessments=record['assessments'], sources=record['sources'], searches=record['searches']))
    for context in sorted(contexts, key=lambda c: c['name']):
        diagnostics = []
        if context['model']['value'] is None: diagnostics.append('model unknown')
        if context['harness']['name'] is None or context['harness']['version'] is None: diagnostics.append('harness unknown')
        if not context['instructions']: diagnostics.append('instruction snapshot absent')
        diagnostics.extend(snapshot_issues(context, available, known_local))
        report['contexts'].append(dict(name=context['name'], snapshot=context, diagnostics=diagnostics))
        findings = []
        for sid, subject in sorted(subjects.items()):
            record = records[subject['parent']]
            def add(kind, reason, differences=None, evidence=None):
                findings.append(dict(context=context['name'], subject=sid, container=subject['parent'], title=record['title'], tier=record['impact']['tier'],
                    kind=kind, reason=reason, differences=differences or [], evidence=evidence or [], sha256=subject['sha256'],
                    next_action={'unknown-origin': 'Recover bounded source evidence or present exact text for human adoption; preserve unknown history.',
                        'uncertain-applicability': 'Assess this subject in the named target context.', 'untested-effectiveness': 'Record an observation or experiment; approval is not effectiveness.',
                        'stale-assessment': 'Make a new assessment against current inputs; retain the old judgment.',
                        'currency-unverifiable': 'Refresh or complete the explicit context snapshot and dependency declaration.',
                        'unassessed-context-drift': 'Consider whether instruction dependencies need a new assessment.'}[kind]))
            origin = origins[sid]
            if not origin['current_adoption']:
                add('unknown-origin', ('Historic authorship unresolved; ' if origin['historic_authorship'] == 'unknown' else '') + 'no evidenced exact-current human adoption.')
            judgments = judgments_by_subject.get(sid, [])
            superseded = {reference_identity(owner, ref) for owner, a in judgments for ref in a['supersedes']}
            def projected_reference(owner, ref):
                return ref if '#' in ref or owner == subject['parent'] else owner + '#' + ref
            def projected_evidence(owner, a):
                return [projected_reference(owner, ref) for ref in a['evidence']]
            current = []
            for owner, a in judgments:
                if (owner, a['id']) in superseded: continue
                comparison = compare_assessment(a, subject, context, available, known_local)
                ident = projected_reference(owner, a['id'])
                evidence = projected_evidence(owner, a)
                if comparison['changed']: add('stale-assessment', 'Recorded judgment differs: ' + ident, comparison['changed'], evidence)
                if comparison['unknown']: add('currency-unverifiable', 'Cannot establish judgment currency: ' + ident, comparison['unknown'], evidence)
                if comparison['drift']: add('unassessed-context-drift', 'Other observed instructions drifted: ' + ident, comparison['drift'], evidence)
                if not comparison['changed'] and not comparison['unknown']: current.append((owner, a))
            fits = [(owner, a) for owner, a in current if a['kind'] == 'applicability']
            if not fits or any(a['result']['verdict'] != 'applicable' for _, a in fits):
                add('uncertain-applicability', 'No matching applicable judgment, or negative/uncertain/conflicting judgments remain.', evidence=[e for owner, a in fits for e in projected_evidence(owner, a)])
            if not any(a['kind'] == 'effectiveness' for _, a in current): add('untested-effectiveness', 'No observation or experiment matches this subject and target context.')
        # Each container/kind appears once, while all clause findings remain inspectable.
        grouped = {}
        for f in findings:
            key = (f['container'], f['kind'])
            if key not in grouped:
                grouped[key] = dict(f, subject=f['container'], sha256=subjects[f['container']]['sha256'], clauses=[], details=[])
            group = grouped[key]
            group['details'].append(f)
            if f['subject'] != f['container']: group['clauses'].append(f)
            group['differences'] = sorted(set(group['differences']) | set(f['differences']))
            group['evidence'] = sorted(set(group['evidence']) | set(f['evidence']))
        report['findings'].extend(grouped.values())
    report['findings'].sort(key=lambda f: (f['context'], TIERS.index(f['tier']), f['subject'], f['kind']))
    return report


def warning_summary(report, baseline, changed):
    counts = {}
    for f in report['findings']:
        key = f['tier'] + '/' + f['kind']; counts[key] = counts.get(key, 0) + 1
    line = f'provenance: {report["coverage"]["rules"]} rules, {report["coverage"]["clauses"]} clauses; tiers ' + ', '.join(f'{k}={v}' for k, v in report['coverage']['tiers'].items())
    line += '; ' + ', '.join(f'{k}={v}' for k, v in sorted(counts.items()))
    lines = [line]
    for c in report['contexts']:
        if c['diagnostics']: lines.append(f'  context {c["name"]}: ' + '; '.join(c['diagnostics']))
    if baseline is None:
        lines.append('  baseline unavailable (initial migration or failed HEAD inventory); totals only. Run provenance for details.')
        return '\n'.join(lines)
    def key(f): return f['context'], f['subject'], f['kind']
    old = {key(f): f for f in baseline['findings']}
    eligible = []
    for f in report['findings']:
        if f['kind'] in ('untested-effectiveness', 'unassessed-context-drift'): continue
        if f['kind'] == 'currency-unverifiable' and next(c for c in report['contexts'] if c['name'] == f['context'])['diagnostics']: continue
        if f['tier'] != 'high' and f['subject'] not in changed: continue
        before = old.get(key(f))
        if f['subject'] in changed or before is None or set(f['differences']) - set(before['differences']) or len(f['clauses']) > len(before['clauses']): eligible.append(f)
    for f in eligible[:5]: lines.append(f'  {f["context"]} {f["subject"][:13]} {f["title"]}: {f["kind"]} — {f["reason"]}')
    if len(eligible) > 5: lines.append(f'  {len(eligible) - 5} details omitted; run provenance for the complete report.')
    return '\n'.join(lines)


def provenance_text(report):
    lines = [f'Provenance: {report["coverage"]["rules"]} rules; {report["coverage"]["clauses"]} clauses. Warnings do not authorize removal.']
    for c in report['contexts']:
        lines.append('Context ' + c['name'] + ': ' + ('; '.join(c['diagnostics']) or 'explicit snapshot supplied; matching inputs do not establish lasting validity.'))
    for f in report['findings']:
        lines.extend([f'{f["context"]} {f["tier"]} {f["subject"]} {f["title"]}: {f["kind"]}', '  ' + f['reason'], '  Next: ' + f['next_action']])
        for detail in f['details']:
            if detail['differences']: lines.append('  ' + detail['subject'] + ': ' + ', '.join(detail['differences']))
        for clause in f['clauses']: lines.append('  Clause ' + clause['subject'] + ': ' + clause['reason'])
    for item in report['history']:
        for subject in item['subjects']: lines.append(f'History {subject["subject"]}: {subject["origin"]}; historic authorship {subject["historic_authorship"]}')
        for a in item['assessments']: lines.append(f'  Assessment {a["id"]} {a["kind"]}: ' + json.dumps(a['result'], sort_keys=True))
        for source in item['sources']: lines.append(f'  Evidence {source["id"]}: {source["access"]}; {source["representation"]}')
    return '\n'.join(lines)


def provenance(root, args):
    index = index_selected(root, args.working_tree)
    if index and read_local(root, ASSEMBLER, index=True) != Path(__file__).read_bytes(): raise ValueError('executing assembler differs from index')
    _, scans = local_scans(root, index=index)
    records, exclusions = read_provenance_inputs(root, index=index)
    validate_rule_set(records, scans, exclusions)
    contexts = [json.loads(Path(path).read_bytes()) for path in args.context]
    report = assess_rules(records, contexts, scans)
    report['findings'] = [f for f in report['findings'] if (not args.tier or f['tier'] in args.tier) and (not args.warning or f['kind'] in args.warning)]
    if args.json: sys.stdout.buffer.write(manifest_bytes(report))
    else: print(provenance_text(report))


def read_exclusions(root, *, index=False, revision=None):
    directory = RULE_DIR + '/exclusions'
    if index: paths = git_bytes(root, 'ls-files', '-z', '--', directory).decode().split('\0')
    elif revision: paths = git_bytes(root, 'ls-tree', '-r', '--name-only', '-z', revision, '--', directory).decode().split('\0')
    else: paths = [p.relative_to(root).as_posix() for p in contained(root, directory).glob('*')]
    exclusions = {}
    for path in paths:
        if not path: continue
        match = re.fullmatch(directory + r'/([a-z][a-z0-9-]*)\.json', path)
        if not match: raise ValueError('invalid exclusion path: ' + path)
        value = json.loads(read_local(root, path, index=index, revision=revision))
        validate_schema(value, rule_schemas()['exclusions'], path)
        if value['fragment'] != match[1]: raise ValueError('exclusion filename/fragment mismatch')
        exclusions[value['fragment']] = value['entries']
    return exclusions


def read_provenance_inputs(root, *, index=False, revision=None):
    for name, schema in rule_schemas().items():
        path = f'instructions/schemas/{name}.json'
        if json.loads(read_local(root, path, index=index, revision=revision)) != schema:
            raise ValueError('schema differs from executing contract: ' + path)
    records = read_rule_set(root, index=index, revision=revision)
    for record in records.values():
        for source in record['sources']:
            locator = source['preservation']
            if locator and locator['owner'] == 'lore' and locator['path'] and source['sha256']:
                # Included copies share the selected view; external locators are never fetched.
                path = locator['path']
                if locator['revision'] is not None: continue
                if index or revision or contained(root, path).exists():
                    if digest(read_local(root, path, index=index, revision=revision)) != source['sha256']:
                        raise ValueError('included evidence hash mismatch: ' + path)
    return records, read_exclusions(root, index=index, revision=revision)


def check_warning_report(root, records, scans):
    report = assess_rules(records, [], scans)
    baseline, previous = None, {}
    try:
        previous = read_rule_set(root, revision='HEAD')
        if previous:
            _, before = local_scans(root, revision='HEAD')
            validate_rule_set(previous, before, read_exclusions(root, revision='HEAD'))
            baseline = assess_rules(previous, [], before)
    except (ValueError, OSError, UnicodeError) as error:
        sys.stderr.write('provenance: HEAD baseline unavailable: ' + str(error) + '\n')
    changed = {rid for rid in records if records[rid] != previous.get(rid)}
    print(warning_summary(report, baseline, changed))


def assemble(catalog_bytes, sources, assembler_bytes, required_ids, *, mode='production', rule_records, exclusions):
    catalog = catalog_from(catalog_bytes)
    mandatory = {f['id'] for f in catalog['fragments'] if f['classification'] == 'mandatory'}
    if required_ids - mandatory:
        raise ValueError('missing or downgraded committed mandatory fragments: ' + ', '.join(sorted(required_ids - mandatory)))
    scans = {f['id']: dict(scan_rules(sources[f['id']]), source=f['source']) for f in catalog['fragments'] if f['owner'] == 'lore'}
    validate_rule_set(rule_records, scans, exclusions)
    parts, records, offset = [], [], 0
    for fragment in catalog['fragments']:
        raw = sources[fragment['id']]
        decoded = raw.decode('utf-8')
        if not raw.endswith(b'\n') or raw.endswith(b'\n\n'):
            raise ValueError(f'{fragment["id"]}: fragment must end in a single newline')
        if fragment['id'] == 'projects':
            if not decoded.startswith(START + '\n') or not decoded.endswith(END + '\n') or decoded.count(START) != 1 or decoded.count(END) != 1:
                raise ValueError('Projects fragment requires exactly the current marked block')
        scan = scans.get(fragment['id'])
        data = scan['rendered'] if scan else raw
        record = dict(fragment)
        rules = []
        for rule in scan['rules'] if scan else []:
            revision = next(r for r in rule_records[rule['id']]['revisions'] if r['sha256'] == rule['sha256'])
            rules.append(dict(id=rule['id'], sha256=rule['sha256'], offset=offset + rule['offset'], length=rule['length'],
                record=record_path(rule['id']), clauses=[dict(id=c['id'], sha256=c['sha256'], offset=offset + rule['offset'] + c['offset'], length=len(c['text'].encode())) for c in revision['clauses']]))
        record.update(revision=blob(raw), sha256=digest(raw), rendered_sha256=digest(data), offset=offset, length=len(data), rules=rules)
        records.append(record); parts.append(data)
        offset += len(data) + 1
    artifact = b'\n'.join(parts)
    manifest = {'version': 2, 'mode': mode, 'separator': '\n', 'fragments': records,
                'artifact': {'path': ARTIFACT, 'sha256': digest(artifact)},
                'catalog': {'path': CATALOG, 'sha256': digest(catalog_bytes)},
                'assembler': {'path': ASSEMBLER, 'revision': blob(assembler_bytes), 'sha256': digest(assembler_bytes)}}
    return artifact, manifest


def committed_minimum(root, revision='HEAD'):
    git_bytes(root, 'rev-parse', '--verify', f'{revision}^{{commit}}')
    if not git_bytes(root, 'ls-tree', '-z', revision, '--', CATALOG): return set()
    catalog = catalog_from(read_local(root, CATALOG, revision=revision))
    return {f['id'] for f in catalog['fragments'] if f['classification'] == 'mandatory'}


def registry():
    config = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    data = tomllib.loads((config / 'tasks/projects.toml').read_text())
    if not isinstance(data.get('projects'), dict):
        raise ValueError('tasks registry requires project roots')
    if not isinstance(data.get('records', {}), dict):
        raise ValueError('tasks registry records must be a table')
    roots = {**data['projects'], **{f'{name}:records': path for name, path in data.get('records', {}).items()}}
    for name, path in roots.items():
        if not isinstance(path, str) or not path.strip():
            raise ValueError(f'tasks registry root for {name} must be a nonempty path')
    return {name: Path(path).expanduser() for name, path in roots.items()}


def owner_roots(catalog, overrides, root, *, validate=False):
    selected = {}
    owners = ({f['owner'] for f in catalog['fragments']} |
              {e['owner'] for f in catalog['fragments'] for e in f['evidence']
               if e['path'] not in ('none recorded', 'n/a')}) - {'lore'}
    for option in overrides:
        name, sep, path = option.partition('=')
        if not sep or not path or name == 'lore' or name not in owners or name in selected:
            raise ValueError('owner-root requires a unique external PREFIX=PATH declared by the catalog')
        selected[name] = Path(path).resolve()
    registered = registry() if owners - selected.keys() or validate and selected else {}
    for name in owners:
        if name not in selected:
            if name not in registered: raise ValueError(f'{name} is not registered in the tasks registry')
            selected[name] = registered[name].resolve()
    if validate:
        for option in overrides:
            name = option.split('=', 1)[0]
            if name not in registered: raise ValueError(f'{name} is not registered in the tasks registry')
            expected = Path(git_bytes(registered[name], 'rev-parse', '--path-format=absolute', '--git-common-dir').decode().strip()).resolve()
            actual = Path(git_bytes(selected[name], 'rev-parse', '--path-format=absolute', '--git-common-dir').decode().strip()).resolve()
            if expected != actual: raise ValueError(f'owner-root must be a checkout of the registered {name} repository')
    return {'lore': root, **selected}


def output_path(root, name):
    path = root / relative_path(name)
    if any(p.is_symlink() for p in (path, *path.parents) if p != root and p.is_relative_to(root)):
        raise ValueError(f'output must not be a symlink: {name}')
    contained(root, name)
    if path.exists() and not path.is_file(): raise ValueError(f'output must be an ordinary file: {name}')
    return path


def manifest_bytes(manifest):
    return (json.dumps(manifest, sort_keys=True, indent=2) + '\n').encode()


def write_pair(root, artifact, manifest):
    values = [(output_path(root, ARTIFACT), artifact), (output_path(root, MANIFEST), manifest_bytes(manifest))]
    prepared = []
    try:
        for path, data in values:
            if path.exists() and path.read_bytes() == data: continue
            with tempfile.NamedTemporaryFile(dir=path.parent, prefix='.' + path.name + '-', delete=False) as temp:
                temp.write(data)
                mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
                os.fchmod(temp.fileno(), mode)
                prepared.append((Path(temp.name), path))
        for temp, path in prepared:
            output_path(root, path.relative_to(root).as_posix())
            os.replace(temp, path)
    finally:
        for temp, _ in prepared: temp.unlink(missing_ok=True)


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('render', 'write', 'check', 'verify-baseline', 'verify-initial'):
        command = sub.add_parser(name)
        command.add_argument('--owner-root', action='append', default=[])
        if name.startswith('verify-'):
            command.add_argument('--revision', required=True)
            if name == 'verify-initial': command.add_argument('--projects-revision', required=True)
        if name == 'render':
            command.add_argument('--manifest', action='store_true')
        if name == 'check':
            command.add_argument('--working-tree', action='store_true')
            command.add_argument('--skip-projects-render', action='store_true')
    add = sub.add_parser('add-rule', help='Create identity and unknown record for an unmarked source range')
    add.add_argument('fragment')
    add.add_argument('--start-line', type=int, required=True)
    add.add_argument('--end-line', type=int, required=True)
    add.add_argument('--title', required=True)
    relations = add.add_mutually_exclusive_group()
    relations.add_argument('--split-from')
    relations.add_argument('--merged-from', nargs='+')
    add.add_argument('--resume', help='Retry an interrupted creation using its printed rule ID')
    refresh_parser = sub.add_parser('refresh', help='Refresh changed rule text without carrying claims forward')
    refresh_parser.add_argument('rules', nargs='*')
    refresh_parser.add_argument('--selectors', help='JSON clause-ID map: {text, offset} or {retire: true}')
    report = sub.add_parser('provenance', help='Read complete provenance and independent context-specific findings')
    report.add_argument('--context', action='append', default=[])
    report.add_argument('--json', action='store_true')
    report.add_argument('--tier', action='append', choices=TIERS, default=[])
    report.add_argument('--warning', action='append', choices=WARNING_KINDS, default=[])
    report.add_argument('--working-tree', action='store_true')
    return parser


def resolve_commit(root, ref):
    return git_bytes(root, 'rev-parse', '--verify', '--end-of-options', f'{ref}^{{commit}}').decode().strip()


FULL_ID = re.compile(r'[0-9a-f]{40}|[0-9a-f]{64}')
BATCH_HEADER = re.compile(rb'([0-9a-f]{40}|[0-9a-f]{64}) (blob|commit|tree|tag) ([0-9]+)')
UNRESOLVED = (b' missing', b' ambiguous')
IMMUTABLE = 'revision must be a full immutable commit id'


def batch_answers(output, count):
    """Parse up to `count` complete `git cat-file --batch -Z` answers, in order.

    An answer is (object name, type), or None for an input Git could not resolve.
    Parsing stops at the first incomplete or malformed answer: where Git stopped streaming."""
    answers, at = [], 0
    while len(answers) < count:
        end = output.find(b'\0', at)
        if end < 0:
            break
        header = BATCH_HEADER.fullmatch(output, at, end)
        if header is None:
            # Every input holds ^ or :, so an unresolved answer never looks like a header.
            if not output[at:end].endswith(UNRESOLVED):
                break  # Not Git's format: the caller reports the answers as missing.
            answers.append(None)
            at = end + 1
            continue
        stop = end + 1 + int(header[3])
        if output[stop:stop + 1] != b'\0':
            break
        answers.append((header[1].decode(), header[2].decode()))
        at = stop + 1
    return answers


def owner_evidence_reasons(owner, root, indexed):
    """Failure reasons by catalog position for one owner's pointers, from one content read.

    Never raises for a Git failure: repository-level failures become a reason at the
    position where today's per-pointer calls would first fail, so the caller's
    catalog-order decision ranks them with every other verdict."""
    reasons = {i: IMMUTABLE for i, p in indexed if not FULL_ID.fullmatch(p['revision'])}
    queried = [(i, p) for i, p in indexed if i not in reasons]
    if not queried:
        return reasons
    # A records directory sits inside its repository, so its paths resolve from that directory.
    base = './' if owner.endswith(':records') else ''
    data = b''.join(f'{p["revision"]}^{{commit}}\0{p["revision"]}:{base}{p["path"]}\0'.encode() for _, p in queried)
    result = git_run(root, 'cat-file', '--batch', '-Z', data=data)
    stderr = result.stderr.decode('utf-8', errors='replace').strip()
    expected = 2 * len(queried)
    answers = batch_answers(result.stdout, expected)
    if not result.returncode:
        failure = f'git cat-file returned {len(answers)} of {expected} answers'
    elif 0 < len(answers) < expected:
        failure = 'historical blob is unreadable: ' + stderr
    else:
        # The call failed as a whole: report it at the owner's first queried pointer.
        failure, answers = 'git failed: ' + stderr, []
    for n, (i, p) in enumerate(queried):
        known = answers[2 * n:2 * n + 2]
        if known[:1] == [None]:
            reasons[i] = IMMUTABLE + '; Git cannot resolve it'
        elif known[:1] and known[0] != (p['revision'], 'commit'):
            reasons[i] = IMMUTABLE
        elif len(known) < 2:
            reasons[i] = failure
        elif known[1] is None or known[1][1] != 'blob':
            reasons[i] = 'historical path must identify a file blob'
        if len(known) < 2:
            break  # Git stopped here; later answers are unknown and later in catalog order.
    return reasons


def validate_evidence(catalog, owners):
    pointers = [e for f in catalog['fragments'] for e in f['evidence'] if e['path'] not in ('none recorded', 'n/a')]
    reasons = {}
    for owner in dict.fromkeys(p['owner'] for p in pointers):
        reasons.update(owner_evidence_reasons(owner, owners[owner],
                                              [(i, p) for i, p in enumerate(pointers) if p['owner'] == owner]))
    for i, p in enumerate(pointers):
        if i in reasons:
            raise ValueError(f'invalid evidence {p["owner"]} {p["revision"]}:{p["path"]}: {reasons[i]}')


def verify_proof(root, args):
    revision = resolve_commit(root, args.revision)
    catalog_bytes = read_local(root, CATALOG, revision=revision)
    catalog = catalog_from(catalog_bytes)
    owners = owner_roots(catalog, args.owner_root, root)
    mode = 'baseline' if args.command == 'verify-baseline' else 'initial'
    sources = {}
    reference = {'mode': mode, 'lore_revision': revision}
    if mode == 'initial':
        ops_revision = resolve_commit(owners['ops'], args.projects_revision)
        reference['ops_revision'] = ops_revision
    else:
        reference['extraction_commit'] = '49568066eeb8a6b4a09e453a10e81fade87919e7'
        reference['global_blob'] = '5297be329c58bc758b20c48a504a87887be5470a'
        reference['projects_snapshot'] = {'owner': 'lore', 'path': 'tools/fixtures/instruction-assembly/baseline-projects.md', 'revision': revision}
    for f in catalog['fragments']:
        if f['owner'] == 'lore':
            data = read_local(root, f['source'], revision=revision)
        elif f['id'] == 'projects' and f['owner'] == 'ops':
            data = read_local(root, 'tools/fixtures/instruction-assembly/baseline-projects.md', revision=revision) if mode == 'baseline' else read_local(owners['ops'], f['source'], revision=ops_revision)
        else:
            raise ValueError('historical proof requires the recorded lore/ops inventory')
        sources[f['id']] = base64.b64encode(data).decode()
    blob_id, expected_hash, fixture = (
        ('5297be329c58bc758b20c48a504a87887be5470a', '66f5ae3d32e218ac3688969171179501ecdcc253e4d9a01f48c05ddb04350642', 'baseline.md')
        if mode == 'baseline' else
        ('08bd5862dcd0fa47000dac7f13e8617875f99586', '2729ca9ae116c50501a65764af73b4729498df283407f8b6a5a5e98e15cc2760', 'initial.md'))
    expected = git_bytes(root, 'cat-file', 'blob', blob_id)
    if digest(expected) != expected_hash or read_local(root, 'tools/fixtures/instruction-assembly/' + fixture, revision=revision) != expected:
        raise ValueError(f'{mode} reference fixture differs from the independent pinned Git blob')
    payload = {'catalog': base64.b64encode(catalog_bytes).decode(), 'sources': sources,
               'required_ids': sorted(committed_minimum(root, revision)), 'mode': mode, 'reference': reference}
    with tempfile.TemporaryDirectory(prefix='instruction-proof-') as temporary:
        directory = Path(temporary)
        pinned = directory / 'assemble-instructions'
        driver = directory / 'driver.py'
        pinned.write_bytes(read_local(root, ASSEMBLER, revision=revision))
        driver.write_bytes(read_local(root, 'tools/instruction-assembly-proof-driver.py', revision=revision))
        result = subprocess.run([sys.executable, str(driver), str(pinned)], cwd=root,
                                input=json.dumps(payload).encode(), capture_output=True)
        if result.returncode:
            raise ValueError(f'{mode} pinned assembler failed: ' + result.stderr.decode(errors='replace').strip())
        if result.stdout != expected:
            raise ValueError(f'{mode} proof differs from the pinned reference bytes')
        if mode == 'initial' and read_local(root, ARTIFACT, revision=revision) != expected:
            raise ValueError('initial committed artifact differs from the pinned reference')
        proof_manifest = json.loads((directory / 'proof-manifest.json').read_bytes())
        if proof_manifest['artifact']['sha256'] != expected_hash or proof_manifest['reference'] != reference:
            raise ValueError('proof manifest does not identify its reference inputs')
    print(f'{mode} proof passed: lore {revision}' + (f' ops {ops_revision}' if mode == 'initial' else '') + f' sha256 {expected_hash}')


def changed_lines(old, new):
    """The lines a Projects change adds or removes, capped so a report stays readable."""
    lines = difflib.unified_diff(old.decode(errors='replace').splitlines(), new.decode(errors='replace').splitlines(), lineterm='', n=0)
    diff = [line for line in list(lines)[2:] if not line.startswith('@@')]
    shown = [f'  {line[0]} {line[1:]}' for line in diff[:EVIDENCE_LINES]]
    if len(diff) > EVIDENCE_LINES: shown.append(f'  … {len(diff) - EVIDENCE_LINES} more changed lines')
    return '\n'.join(shown)


def projects_block(data):
    """(prefix, block, suffix) around the one marked Projects block, or None when markers are not exactly one ordered pair."""
    start, end = START.encode(), END.encode()
    if data.count(start) != 1 or data.count(end) != 1: return None
    a, b = data.index(start), data.index(end) + len(end)
    return (data[:a], data[a:b], data[b:]) if a < b else None


def artifact_drift(actual, expected):
    found, wanted = projects_block(actual), projects_block(expected)
    if found and wanted and found[0] == wanted[0] and found[2] == wanted[2]:
        return ('artifact Projects block stale: the external Projects input (owner ops) changed since the last assembly; '
                'run just assemble in lore\n' + changed_lines(found[1], wanted[1]))
    return 'artifact stale; edit instructions/fragments/… then run just assemble in lore'


def index_selected(root, working_tree):
    if working_tree:
        return False
    changed = {p.decode() for p in git_bytes(root, 'diff', '--cached', '--name-only', '--no-renames', '-z').split(b'\0') if p}
    fixed = {CATALOG, ARTIFACT, MANIFEST, ASSEMBLER}
    if changed & fixed or any(p.startswith(('instructions/fragments/', 'instructions/rules/', 'instructions/schemas/')) for p in changed):
        return True
    if changed:
        catalog = catalog_from(read_local(root, CATALOG, index=True))
        fixed |= {f['source'] for f in catalog['fragments'] if f['owner'] == 'lore'}
    return bool(changed & fixed)


def main(argv=None):
    args = build_parser().parse_args(argv)
    root = Path(__file__).resolve().parents[1]
    try:
        if args.command.startswith('verify-'):
            verify_proof(root, args)
            return 0
        if args.command == 'provenance':
            provenance(root, args)
            return 0
        if args.command in ('add-rule', 'refresh'):
            (add_rule if args.command == 'add-rule' else refresh)(root, args)
            return 0
        index = args.command == 'check' and index_selected(root, args.working_tree)
        assembler_bytes = read_local(root, ASSEMBLER, index=index)
        if index and assembler_bytes != Path(__file__).read_bytes():
            raise ValueError('executing assembler differs from index; stage intended assembler or restore index version')
        catalog_bytes = read_local(root, CATALOG, index=index)
        catalog = catalog_from(catalog_bytes)
        owners = owner_roots(catalog, args.owner_root, root, validate=args.command in ('write', 'check'))
        validate_evidence(catalog, owners)
        if args.command == 'check' and args.owner_root:
            for option in args.owner_root: sys.stderr.write(f'assemble-instructions: owner-root override {option}\n')
        sources = {f['id']: read_local(owners[f['owner']], f['source'], index=index and f['owner'] == 'lore') for f in catalog['fragments']}
        records, exclusions = read_provenance_inputs(root, index=index)
        artifact, manifest = assemble(catalog_bytes, sources, assembler_bytes, committed_minimum(root), rule_records=records, exclusions=exclusions)
        if args.command == 'render': sys.stdout.buffer.write(manifest_bytes(manifest) if args.manifest else artifact)
        elif args.command == 'write': write_pair(root, artifact, manifest)
        else:
            if not args.skip_projects_render:
                rendered = subprocess.run([sys.executable, str(owners['ops'] / 'bin/ops-projects'), 'render'], cwd=owners['ops'], capture_output=True)
                if rendered.returncode: raise ValueError('ops-projects render failed: ' + rendered.stderr.decode(errors='replace').strip())
                if rendered.stdout != sources['projects']:
                    raise ValueError('Projects input differs from this host\'s current project rendering (a project was registered, renamed or retired; owner ops); '
                                     'run just projects in ops, then just assemble in lore\n' + changed_lines(sources['projects'], rendered.stdout))
            selected = read_local(root, ARTIFACT, index=index)
            if selected != artifact: raise ValueError(artifact_drift(selected, artifact))
            if read_local(root, MANIFEST, index=index) != manifest_bytes(manifest):
                raise ValueError('manifest stale or unsupported version; run just assemble in lore')
            scans = {f['id']: scan_rules(sources[f['id']]) for f in catalog['fragments'] if f['owner'] == 'lore'}
            check_warning_report(root, records, scans)
        return 0
    except (ValueError, OSError, UnicodeError) as error:
        sys.stderr.write(f'assemble-instructions: {error}\n')
        return 1


if __name__ == '__main__':
    sys.exit(main())
