#!/usr/bin/env python3
"""Build global instructions and source provenance from an explicit catalog."""
import argparse
import base64
import datetime
import difflib
import functools
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
import subprocess
import sys
import tempfile
import tomllib

CATALOG = 'instructions/assembly.toml'
ARTIFACT = 'instructions/AGENTS.md'
MANIFEST = 'instructions/AGENTS.manifest.json'
ASSEMBLER = 'bin/assemble-instructions'
START = '<!-- ops:projects start — generated by ops-projects; edit identity.toml in the project, or identity-mirror.toml in ops -->'
END = '<!-- ops:projects end -->'
FRAGMENT_FIELDS = {'id', 'owner', 'source', 'classification', 'rationale', 'provenance_date', 'evidence'}
EVIDENCE_FIELDS = {'owner', 'path', 'revision', 'location', 'status'}
EVIDENCE_LINES = 12


def git_run(root, *args, data=None):
    env = os.environ
    if root.resolve() != Path(__file__).resolve().parents[1]:
        # Hooks select lore's Git directory/index; foreign repositories must select their own.
        env = {key: value for key, value in env.items() if key not in local_env_names()}
    return subprocess.run(['git', '-C', str(root), *args], input=data, capture_output=True, env=env)


def git_bytes(root, *args, data=None):
    result = git_run(root, *args, data=data)
    if result.returncode:
        raise ValueError('git failed: ' + result.stderr.decode('utf-8', errors='replace').strip())
    return result.stdout


@functools.cache
def local_env_names():
    # The names depend on the Git binary, not the repository, so one answer serves the run.
    executing_root = Path(__file__).resolve().parents[1]
    return frozenset(git_bytes(executing_root, 'rev-parse', '--local-env-vars').decode().split())


def relative_path(path):
    if not isinstance(path, str) or not path or '\\' in path or '\0' in path:
        raise ValueError('source must be a nonempty owner-relative path')
    p = PurePosixPath(path)
    if p.is_absolute() or '..' in p.parts or str(p) != path:
        raise ValueError(f'source path escapes or is not canonical: {path}')
    return path


def contained(root, path):
    target = root / relative_path(path)
    if not target.resolve().is_relative_to(root.resolve()):
        raise ValueError(f'source leaves its owner checkout: {path}')
    return target


def read_local(root, path, *, index=False, revision=None):
    relative_path(path)
    if index and revision is not None:
        raise ValueError('choose one Git view')
    if index or revision is not None:
        return git_bytes(root, 'show', f'{"" if index else revision}:{path}')
    return contained(root, path).read_bytes()


def fields(value, expected, label):
    if not isinstance(value, dict) or set(value) != expected:
        raise ValueError(f'{label}: fields must be {", ".join(sorted(expected))}')


def text(value, label):
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f'{label} must be nonempty text')


def catalog_from(data):
    catalog = tomllib.loads(data.decode('utf-8'))
    fields(catalog, {'version', 'separator', 'fragments'}, 'catalog')
    if type(catalog['version']) is not int or catalog['version'] != 1 or catalog['separator'] != '\n':
        raise ValueError('catalog requires version 1 and a single newline separator')
    if not isinstance(catalog['fragments'], list) or not catalog['fragments']:
        raise ValueError('catalog must declare fragments')
    seen = set()
    for f in catalog['fragments']:
        fields(f, FRAGMENT_FIELDS, 'fragment')
        for key in ('id', 'owner', 'source', 'classification', 'rationale', 'provenance_date'):
            text(f[key], key)
        if not re.fullmatch(r'[a-z][a-z0-9-]*', f['id']) or f['id'] in seen:
            raise ValueError(f'duplicate or invalid fragment id: {f["id"]}')
        seen.add(f['id'])
        if not re.fullmatch(r'[a-z][a-z0-9]{1,7}', f['owner']):
            raise ValueError('invalid owner prefix')
        relative_path(f['source'])
        if f['classification'] not in ('mandatory', 'adaptable'):
            raise ValueError('classification must be mandatory or adaptable')
        if datetime.date.fromisoformat(f['provenance_date']).isoformat() != f['provenance_date']:
            raise ValueError('provenance date must be YYYY-MM-DD')
        if not isinstance(f['evidence'], list) or not f['evidence']:
            raise ValueError('explicit evidence is required')
        for evidence in f['evidence']:
            fields(evidence, EVIDENCE_FIELDS, 'evidence')
            for key in EVIDENCE_FIELDS:
                text(evidence[key], 'evidence ' + key)
            # PREFIX names a project's checkout; PREFIX:records its records directory.
            if not re.fullmatch(r'[a-z][a-z0-9]{1,7}(:records)?', evidence['owner']):
                raise ValueError('invalid evidence owner prefix')
            if evidence['status'] not in ('recorded', 'none recorded', 'n/a'):
                raise ValueError('evidence status must be recorded, none recorded or n/a')
            if evidence['path'] in ('none recorded', 'n/a') or evidence['revision'] in ('none recorded', 'n/a'):
                if evidence['path'] != evidence['revision']:
                    raise ValueError('evidence path and revision must use the same sentinel')
            if evidence['path'] not in ('none recorded', 'n/a'):
                relative_path(evidence['path'])
    return catalog


def digest(data):
    return hashlib.sha256(data).hexdigest()


def blob(data):
    # Git's SHA-1 object id for a blob; lore is a SHA-1 repository.
    return hashlib.sha1(b'blob %d\0' % len(data) + data).hexdigest()


def assemble(catalog_bytes, sources, assembler_bytes, required_ids, *, mode='production'):
    catalog = catalog_from(catalog_bytes)
    mandatory = {f['id'] for f in catalog['fragments'] if f['classification'] == 'mandatory'}
    if required_ids - mandatory:
        raise ValueError('missing or downgraded committed mandatory fragments: ' + ', '.join(sorted(required_ids - mandatory)))
    parts, records, offset = [], [], 0
    for fragment in catalog['fragments']:
        data = sources[fragment['id']]
        decoded = data.decode('utf-8')
        if not data.endswith(b'\n') or data.endswith(b'\n\n'):
            raise ValueError(f'{fragment["id"]}: fragment must end in a single newline')
        if fragment['id'] == 'projects':
            if not decoded.startswith(START + '\n') or not decoded.endswith(END + '\n') or decoded.count(START) != 1 or decoded.count(END) != 1:
                raise ValueError('Projects fragment requires exactly the current marked block')
        record = dict(fragment)
        record.update(revision=blob(data), sha256=digest(data), offset=offset, length=len(data))
        records.append(record)
        parts.append(data)
        offset += len(data) + 1
    artifact = b'\n'.join(parts)
    manifest = {'version': 1, 'mode': mode, 'separator': '\n', 'fragments': records,
                'artifact': {'path': ARTIFACT, 'sha256': digest(artifact)},
                'catalog': {'path': CATALOG, 'sha256': digest(catalog_bytes)},
                'assembler': {'path': ASSEMBLER, 'revision': blob(assembler_bytes), 'sha256': digest(assembler_bytes)}}
    return artifact, manifest


def committed_minimum(root, revision='HEAD'):
    git_bytes(root, 'rev-parse', '--verify', f'{revision}^{{commit}}')
    if not git_bytes(root, 'ls-tree', '-z', revision, '--', MANIFEST):
        return set()
    manifest = json.loads(read_local(root, MANIFEST, revision=revision))
    fields(manifest, {'version', 'mode', 'separator', 'fragments', 'artifact', 'catalog', 'assembler'}, 'committed manifest')
    if type(manifest['version']) is not int or manifest['version'] != 1 or manifest['mode'] != 'production' or manifest['separator'] != '\n' or not isinstance(manifest['fragments'], list) or not manifest['fragments']:
        raise ValueError('invalid committed manifest')
    ids = set()
    for f in manifest['fragments']:
        if not isinstance(f, dict) or f.get('classification') not in ('mandatory', 'adaptable') or not isinstance(f.get('id'), str):
            raise ValueError('invalid committed manifest fragment')
        if f['classification'] == 'mandatory': ids.add(f['id'])
    return ids


def registry():
    config = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    data = tomllib.loads((config / 'tasks/projects.toml').read_text())
    if not isinstance(data.get('projects'), dict):
        raise ValueError('tasks registry requires project roots')
    if not isinstance(data.get('records', {}), dict):
        raise ValueError('tasks registry records must be a table')
    roots = {**data['projects'], **{f'{name}:records': path for name, path in data.get('records', {}).items()}}
    for name, path in roots.items():
        if not isinstance(path, str) or not path.strip():
            raise ValueError(f'tasks registry root for {name} must be a nonempty path')
    return {name: Path(path).expanduser() for name, path in roots.items()}


def owner_roots(catalog, overrides, root, *, validate=False):
    selected = {}
    owners = ({f['owner'] for f in catalog['fragments']} |
              {e['owner'] for f in catalog['fragments'] for e in f['evidence']
               if e['path'] not in ('none recorded', 'n/a')}) - {'lore'}
    for option in overrides:
        name, sep, path = option.partition('=')
        if not sep or not path or name == 'lore' or name not in owners or name in selected:
            raise ValueError('owner-root requires a unique external PREFIX=PATH declared by the catalog')
        selected[name] = Path(path).resolve()
    registered = registry() if owners - selected.keys() or validate and selected else {}
    for name in owners:
        if name not in selected:
            if name not in registered: raise ValueError(f'{name} is not registered in the tasks registry')
            selected[name] = registered[name].resolve()
    if validate:
        for option in overrides:
            name = option.split('=', 1)[0]
            if name not in registered: raise ValueError(f'{name} is not registered in the tasks registry')
            expected = Path(git_bytes(registered[name], 'rev-parse', '--path-format=absolute', '--git-common-dir').decode().strip()).resolve()
            actual = Path(git_bytes(selected[name], 'rev-parse', '--path-format=absolute', '--git-common-dir').decode().strip()).resolve()
            if expected != actual: raise ValueError(f'owner-root must be a checkout of the registered {name} repository')
    return {'lore': root, **selected}


def output_path(root, name):
    path = root / relative_path(name)
    if path.is_symlink(): raise ValueError(f'output must not be a symlink: {name}')
    contained(root, name)
    if path.exists() and not path.is_file(): raise ValueError(f'output must be an ordinary file: {name}')
    return path


def manifest_bytes(manifest):
    return (json.dumps(manifest, sort_keys=True, indent=2) + '\n').encode()


def write_pair(root, artifact, manifest):
    values = [(output_path(root, ARTIFACT), artifact), (output_path(root, MANIFEST), manifest_bytes(manifest))]
    prepared = []
    try:
        for path, data in values:
            if path.exists() and path.read_bytes() == data: continue
            with tempfile.NamedTemporaryFile(dir=path.parent, prefix='.' + path.name + '-', delete=False) as temp:
                temp.write(data)
                mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
                os.fchmod(temp.fileno(), mode)
                prepared.append((Path(temp.name), path))
        for temp, path in prepared:
            output_path(root, path.relative_to(root).as_posix())
            os.replace(temp, path)
    finally:
        for temp, _ in prepared: temp.unlink(missing_ok=True)


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('render', 'write', 'check', 'verify-baseline', 'verify-initial'):
        command = sub.add_parser(name)
        command.add_argument('--owner-root', action='append', default=[])
        if name.startswith('verify-'):
            command.add_argument('--revision', required=True)
            if name == 'verify-initial': command.add_argument('--projects-revision', required=True)
        if name == 'render':
            command.add_argument('--manifest', action='store_true')
        if name == 'check':
            command.add_argument('--working-tree', action='store_true')
            command.add_argument('--skip-projects-render', action='store_true')
    return parser


def resolve_commit(root, ref):
    return git_bytes(root, 'rev-parse', '--verify', '--end-of-options', f'{ref}^{{commit}}').decode().strip()


FULL_ID = re.compile(r'[0-9a-f]{40}|[0-9a-f]{64}')
BATCH_HEADER = re.compile(rb'([0-9a-f]{40}|[0-9a-f]{64}) (blob|commit|tree|tag) ([0-9]+)')
UNRESOLVED = (b' missing', b' ambiguous')
IMMUTABLE = 'revision must be a full immutable commit id'


def batch_answers(output, count):
    """Parse up to `count` complete `git cat-file --batch -Z` answers, in order.

    An answer is (object name, type), or None for an input Git could not resolve.
    Parsing stops at the first incomplete or malformed answer: where Git stopped streaming."""
    answers, at = [], 0
    while len(answers) < count:
        end = output.find(b'\0', at)
        if end < 0:
            break
        header = BATCH_HEADER.fullmatch(output, at, end)
        if header is None:
            # Every input holds ^ or :, so an unresolved answer never looks like a header.
            if not output[at:end].endswith(UNRESOLVED):
                break  # Not Git's format: the caller reports the answers as missing.
            answers.append(None)
            at = end + 1
            continue
        stop = end + 1 + int(header[3])
        if output[stop:stop + 1] != b'\0':
            break
        answers.append((header[1].decode(), header[2].decode()))
        at = stop + 1
    return answers


def owner_evidence_reasons(owner, root, indexed):
    """Failure reasons by catalog position for one owner's pointers, from one content read.

    Never raises for a Git failure: repository-level failures become a reason at the
    position where today's per-pointer calls would first fail, so the caller's
    catalog-order decision ranks them with every other verdict."""
    reasons = {i: IMMUTABLE for i, p in indexed if not FULL_ID.fullmatch(p['revision'])}
    queried = [(i, p) for i, p in indexed if i not in reasons]
    if not queried:
        return reasons
    # A records directory sits inside its repository, so its paths resolve from that directory.
    base = './' if owner.endswith(':records') else ''
    data = b''.join(f'{p["revision"]}^{{commit}}\0{p["revision"]}:{base}{p["path"]}\0'.encode() for _, p in queried)
    result = git_run(root, 'cat-file', '--batch', '-Z', data=data)
    stderr = result.stderr.decode('utf-8', errors='replace').strip()
    expected = 2 * len(queried)
    answers = batch_answers(result.stdout, expected)
    if not result.returncode:
        failure = f'git cat-file returned {len(answers)} of {expected} answers'
    elif 0 < len(answers) < expected:
        failure = 'historical blob is unreadable: ' + stderr
    else:
        # The call failed as a whole: report it at the owner's first queried pointer.
        failure, answers = 'git failed: ' + stderr, []
    for n, (i, p) in enumerate(queried):
        known = answers[2 * n:2 * n + 2]
        if known[:1] == [None]:
            reasons[i] = IMMUTABLE + '; Git cannot resolve it'
        elif known[:1] and known[0] != (p['revision'], 'commit'):
            reasons[i] = IMMUTABLE
        elif len(known) < 2:
            reasons[i] = failure
        elif known[1] is None or known[1][1] != 'blob':
            reasons[i] = 'historical path must identify a file blob'
        if len(known) < 2:
            break  # Git stopped here; later answers are unknown and later in catalog order.
    return reasons


def validate_evidence(catalog, owners):
    pointers = [e for f in catalog['fragments'] for e in f['evidence'] if e['path'] not in ('none recorded', 'n/a')]
    reasons = {}
    for owner in dict.fromkeys(p['owner'] for p in pointers):
        reasons.update(owner_evidence_reasons(owner, owners[owner],
                                              [(i, p) for i, p in enumerate(pointers) if p['owner'] == owner]))
    for i, p in enumerate(pointers):
        if i in reasons:
            raise ValueError(f'invalid evidence {p["owner"]} {p["revision"]}:{p["path"]}: {reasons[i]}')


def verify_proof(root, args):
    revision = resolve_commit(root, args.revision)
    catalog_bytes = read_local(root, CATALOG, revision=revision)
    catalog = catalog_from(catalog_bytes)
    owners = owner_roots(catalog, args.owner_root, root)
    mode = 'baseline' if args.command == 'verify-baseline' else 'initial'
    sources = {}
    reference = {'mode': mode, 'lore_revision': revision}
    if mode == 'initial':
        ops_revision = resolve_commit(owners['ops'], args.projects_revision)
        reference['ops_revision'] = ops_revision
    else:
        reference['extraction_commit'] = 'e8104e0c6b51655100ac96dd83daba82649d0755'
        reference['global_blob'] = '5297be329c58bc758b20c48a504a87887be5470a'
        reference['projects_snapshot'] = {'owner': 'lore', 'path': 'tools/fixtures/instruction-assembly/baseline-projects.md', 'revision': revision}
    for f in catalog['fragments']:
        if f['owner'] == 'lore':
            data = read_local(root, f['source'], revision=revision)
        elif f['id'] == 'projects' and f['owner'] == 'ops':
            data = read_local(root, 'tools/fixtures/instruction-assembly/baseline-projects.md', revision=revision) if mode == 'baseline' else read_local(owners['ops'], f['source'], revision=ops_revision)
        else:
            raise ValueError('historical proof requires the recorded lore/ops inventory')
        sources[f['id']] = base64.b64encode(data).decode()
    blob_id, expected_hash, fixture = (
        ('5297be329c58bc758b20c48a504a87887be5470a', '66f5ae3d32e218ac3688969171179501ecdcc253e4d9a01f48c05ddb04350642', 'baseline.md')
        if mode == 'baseline' else
        ('08bd5862dcd0fa47000dac7f13e8617875f99586', '2729ca9ae116c50501a65764af73b4729498df283407f8b6a5a5e98e15cc2760', 'initial.md'))
    expected = git_bytes(root, 'cat-file', 'blob', blob_id)
    if digest(expected) != expected_hash or read_local(root, 'tools/fixtures/instruction-assembly/' + fixture, revision=revision) != expected:
        raise ValueError(f'{mode} reference fixture differs from the independent pinned Git blob')
    payload = {'catalog': base64.b64encode(catalog_bytes).decode(), 'sources': sources,
               'required_ids': sorted(committed_minimum(root, revision)), 'mode': mode, 'reference': reference}
    with tempfile.TemporaryDirectory(prefix='instruction-proof-') as temporary:
        directory = Path(temporary)
        pinned = directory / 'assemble-instructions'
        driver = directory / 'driver.py'
        pinned.write_bytes(read_local(root, ASSEMBLER, revision=revision))
        driver.write_bytes(read_local(root, 'tools/instruction-assembly-proof-driver.py', revision=revision))
        result = subprocess.run([sys.executable, str(driver), str(pinned)], cwd=root,
                                input=json.dumps(payload).encode(), capture_output=True)
        if result.returncode:
            raise ValueError(f'{mode} pinned assembler failed: ' + result.stderr.decode(errors='replace').strip())
        if result.stdout != expected:
            raise ValueError(f'{mode} proof differs from the pinned reference bytes')
        if mode == 'initial' and read_local(root, ARTIFACT, revision=revision) != expected:
            raise ValueError('initial committed artifact differs from the pinned reference')
        proof_manifest = json.loads((directory / 'proof-manifest.json').read_bytes())
        if proof_manifest['artifact']['sha256'] != expected_hash or proof_manifest['reference'] != reference:
            raise ValueError('proof manifest does not identify its reference inputs')
    print(f'{mode} proof passed: lore {revision}' + (f' ops {ops_revision}' if mode == 'initial' else '') + f' sha256 {expected_hash}')


def changed_lines(old, new):
    """The lines a Projects change adds or removes, capped so a report stays readable."""
    lines = difflib.unified_diff(old.decode(errors='replace').splitlines(), new.decode(errors='replace').splitlines(), lineterm='', n=0)
    diff = [line for line in list(lines)[2:] if not line.startswith('@@')]
    shown = [f'  {line[0]} {line[1:]}' for line in diff[:EVIDENCE_LINES]]
    if len(diff) > EVIDENCE_LINES: shown.append(f'  … {len(diff) - EVIDENCE_LINES} more changed lines')
    return '\n'.join(shown)


def projects_block(data):
    """(prefix, block, suffix) around the one marked Projects block, or None when markers are not exactly one ordered pair."""
    start, end = START.encode(), END.encode()
    if data.count(start) != 1 or data.count(end) != 1: return None
    a, b = data.index(start), data.index(end) + len(end)
    return (data[:a], data[a:b], data[b:]) if a < b else None


def artifact_drift(actual, expected):
    found, wanted = projects_block(actual), projects_block(expected)
    if found and wanted and found[0] == wanted[0] and found[2] == wanted[2]:
        return ('artifact Projects block stale: the external Projects input (owner ops) changed since the last assembly; '
                'run just assemble in lore\n' + changed_lines(found[1], wanted[1]))
    return 'artifact stale; edit instructions/fragments/… then run just assemble in lore'


def index_selected(root, working_tree):
    if working_tree:
        return False
    changed = {p.decode() for p in git_bytes(root, 'diff', '--cached', '--name-only', '--no-renames', '-z').split(b'\0') if p}
    fixed = {CATALOG, ARTIFACT, MANIFEST, ASSEMBLER}
    if changed & fixed or any(p.startswith('instructions/fragments/') for p in changed):
        return True
    if changed:
        catalog = catalog_from(read_local(root, CATALOG, index=True))
        fixed |= {f['source'] for f in catalog['fragments'] if f['owner'] == 'lore'}
    return bool(changed & fixed)


def main(argv=None):
    args = build_parser().parse_args(argv)
    root = Path(__file__).resolve().parents[1]
    try:
        if args.command.startswith('verify-'):
            verify_proof(root, args)
            return 0
        index = args.command == 'check' and index_selected(root, args.working_tree)
        assembler_bytes = read_local(root, ASSEMBLER, index=index)
        if index and assembler_bytes != Path(__file__).read_bytes():
            raise ValueError('executing assembler differs from index; stage intended assembler or restore index version')
        catalog_bytes = read_local(root, CATALOG, index=index)
        catalog = catalog_from(catalog_bytes)
        owners = owner_roots(catalog, args.owner_root, root, validate=args.command in ('write', 'check'))
        validate_evidence(catalog, owners)
        if args.command == 'check' and args.owner_root:
            for option in args.owner_root: sys.stderr.write(f'assemble-instructions: owner-root override {option}\n')
        sources = {f['id']: read_local(owners[f['owner']], f['source'], index=index and f['owner'] == 'lore') for f in catalog['fragments']}
        artifact, manifest = assemble(catalog_bytes, sources, assembler_bytes, committed_minimum(root))
        if args.command == 'render': sys.stdout.buffer.write(manifest_bytes(manifest) if args.manifest else artifact)
        elif args.command == 'write': write_pair(root, artifact, manifest)
        else:
            if not args.skip_projects_render:
                rendered = subprocess.run([sys.executable, str(owners['ops'] / 'bin/ops-projects'), 'render'], cwd=owners['ops'], capture_output=True)
                if rendered.returncode: raise ValueError('ops-projects render failed: ' + rendered.stderr.decode(errors='replace').strip())
                if rendered.stdout != sources['projects']:
                    raise ValueError('Projects input differs from this host\'s current project rendering (a project was registered, renamed or retired; owner ops); '
                                     'run just projects in ops, then just assemble in lore\n' + changed_lines(sources['projects'], rendered.stdout))
            selected = read_local(root, ARTIFACT, index=index)
            if selected != artifact: raise ValueError(artifact_drift(selected, artifact))
            if read_local(root, MANIFEST, index=index) != manifest_bytes(manifest):
                raise ValueError('manifest stale; run just assemble in lore')
        return 0
    except (ValueError, OSError, UnicodeError) as error:
        sys.stderr.write(f'assemble-instructions: {error}\n')
        return 1


if __name__ == '__main__':
    sys.exit(main())
