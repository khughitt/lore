#!/usr/bin/env python3
"""Launch the checkout's uninstalled standard-library package."""
import os
import pathlib
import sys
sys.dont_write_bytecode = True
ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'src'))
try:
    from lore.cli import main
except Exception as error:
    if sys.argv[1:3] != ['hook', 'profile-notice']:
        raise
    # The profile notice turns every failure into one visible line, a broken package
    # included; the text matches lore._hooks.unresolved and hooks/claude-profile.
    import json
    import shlex
    reason = ' '.join(str(error).splitlines())
    recovery = shlex.join([str(ROOT / 'bin/lore'), 'profile', 'session'])
    line = f'profile: unresolved — {reason}; repair the lore checkout, then run {recovery}\n'
    sys.stdout.write(json.dumps({'context': line}))
    raise SystemExit(0)

raise SystemExit(main(sys.argv[1:], os.environ, os.getcwd()))
