#!/usr/bin/env python3
"""SessionStart profile delivery; failures are visible text, never a blocked session."""
import json
import os
import pathlib
import shlex
import sys

sys.dont_write_bytecode = True
ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'src'))


def unresolved(error):
    reason = ' '.join(str(error).splitlines())
    recovery = shlex.join([str(ROOT / 'bin/lore'), 'profile', 'session'])
    sys.stdout.write(f'profile: unresolved — {reason}; repair the lore checkout, then run {recovery}\n')
    return 0


def main(text, env, fallback_cwd):
    try:
        payload = json.loads(text or 'null')
    except json.JSONDecodeError:
        payload = None
    if not isinstance(payload, dict): payload = None
    try:
        from lore import resolve, session_text
        cwd = payload.get('cwd') if payload else None
        result = resolve(cwd or fallback_cwd, env, payload)
        output = session_text(result)
        if env.get('CLAUDE_ENV_FILE'):
            with open(env['CLAUDE_ENV_FILE'], 'a') as handle:
                names = ','.join(p['name'] for p in result['profiles'])
                handle.write(f'export AGENT_PROFILE={names}\n')
    except Exception as error:
        return unresolved(error)
    sys.stdout.write(output)
    return 0


if __name__ == '__main__':
    try:
        status = main(sys.stdin.read(), os.environ, os.getcwd())
    except Exception as error:
        status = unresolved(error)
    sys.exit(status)
