#!/usr/bin/env python3
"""SessionStart: add the checkout profile layer to the agent's context. Claude and
Codex both run it and send the same payload shape; its transcript_path is what names
the harness home (see ops-profile home_of)."""
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import sys

HERE = pathlib.Path(__file__).resolve().parent


def _load(path):
    loader = importlib.machinery.SourceFileLoader(path.name.replace("-", "_"), str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main(text, env, fallback_cwd):
    try:
        payload = json.loads(text or "null")
    except json.JSONDecodeError:
        payload = None
    if not isinstance(payload, dict):
        payload = None
    cwd = payload.get("cwd") if payload else None
    profiles = _load(HERE.parent / "bin" / "ops-profile")
    try:
        res = profiles.resolve(cwd or fallback_cwd, env, payload)
    except (profiles.ProfileError, ValueError) as error:
        sys.stdout.write(f"profile: unresolved — {error}; run ops-profile session after fixing it\n")
        return 0
    sys.stdout.write(profiles.session_text(res))
    if env_file := env.get("CLAUDE_ENV_FILE"):
        with open(env_file, "a") as handle:
            names = ",".join(item["name"] for item in res["profiles"])
            handle.write(f"export AGENT_PROFILE={names}\n")
    return 0


if __name__ == "__main__":
    try:
        code = main(sys.stdin.read(), os.environ, os.getcwd())
    except Exception:
        code = 0
    sys.exit(code)
