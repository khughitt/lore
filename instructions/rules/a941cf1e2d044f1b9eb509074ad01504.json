  "relations": [],
  "revisions": [
    {
      "clauses": [
        {
          "id": "clause:7dfef4a41bc44c71a7e4a0b0f6c37601",
          "offset": 0,
          "overlaps": [],
          "parent_sha256": "0d5173d0f79ac6b0d265e3369542a70ae7a4b80e0dd00456d8184bb407a4a114",
          "sha256": "1db69b3bb98ca05fbd90589c1246db9444e3ff86125664d28de093a7bd0e688e",
          "text": "- A dispatch that asks a subagent to write its report to a file names that file\n  `<slug>-report.md` (`task-3-report.md`, `audit-report.md`), "
        },
        {
          "id": "clause:6fd12fa56d284a2496ff2368002169ca",
          "offset": 142,
          "overlaps": [],
          "parent_sha256": "0d5173d0f79ac6b0d265e3369542a70ae7a4b80e0dd00456d8184bb407a4a114",
          "sha256": "25fa8c883df044ad318cd2d60f77d89a60a66a095b88573fcbf57fea4cc56401",
          "text": "never a `.md` name\n  starting with `report`, `summary`, `findings` or `analysis` in any case\n  (`report.md`, `Summary-x.md`, `findings.md`). "
        },
        {
          "id": "clause:acda73ec0b1645698cd15b9c7cfd44e0",
          "offset": 283,
          "overlaps": [],
          "parent_sha256": "0d5173d0f79ac6b0d265e3369542a70ae7a4b80e0dd00456d8184bb407a4a114",
          "sha256": "0d29bf2f0094814ef806968406eaf8a957ea1b5e8e87076f5ab42250264629a8",
          "text": "Claude Code refuses a subagent's write\n  to those names (\"Subagents should return findings as text\"), and the whole report\n  then lands in the subagent's final message instead of the file. "
        },
        {
          "id": "clause:1489fd27df4b44ed89bb624d313718fc",
          "offset": 472,
          "overlaps": [],
          "parent_sha256": "0d5173d0f79ac6b0d265e3369542a70ae7a4b80e0dd00456d8184bb407a4a114",
          "sha256": "f8ff82ab1bb1f1f7997f551cf995d7f4257f1e17d3e3331e16f19f6f9bb12d1f",
          "text": "hq's\n  `subagent-write-refused` capability fact records the rule and its probe.\n"
        }
      ],
      "locator": null,
      "sha256": "0d5173d0f79ac6b0d265e3369542a70ae7a4b80e0dd00456d8184bb407a4a114",
      "text": "- A dispatch that asks a subagent to write its report to a file names that file\n  `<slug>-report.md` (`task-3-report.md`, `audit-report.md`), never a `.md` name\n  starting with `report`, `summary`, `findings` or `analysis` in any case\n  (`report.md`, `Summary-x.md`, `findings.md`). Claude Code refuses a subagent's write\n  to those names (\"Subagents should return findings as text\"), and the whole report\n  then lands in the subagent's final message instead of the file. hq's\n  `subagent-write-refused` capability fact records the rule and its probe.\n"
    }
  ],
