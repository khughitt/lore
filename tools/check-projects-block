#!/usr/bin/env python3
"""Validate instructions/AGENTS.md against the registered ops Projects renderer.

Run from the repository root; the target and index lookup are root-relative.
Use staged content when the target is staged, rejecting deletion or rename;
otherwise validate the working copy. This command only reads instructions.
The Projects and Feedback-owners block is generated with `just projects` in ops.
"""
import difflib
import os
import pathlib
import subprocess
import sys
import tomllib

MARK_START = "<!-- ops:projects start — generated by ops-projects; edit identity.toml in the project, or identity-mirror.toml in ops -->"
PREVIOUS_MARK_START = "<!-- ops:projects start — generated by ops-projects; edit identity-mirror.toml in ops -->"
MARK_END = "<!-- ops:projects end -->"
TARGET = "instructions/AGENTS.md"


def fail(message):
    sys.stderr.write(f"check-projects-block: {message}\n")
    return 1


def ops_root():
    config = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config")
    path = config / "tasks" / "projects.toml"
    if not path.is_file():
        raise LookupError(f"{path} is missing; the tasks registry locates the ops checkout")
    roots = tomllib.loads(path.read_text()).get("projects", {})
    if "ops" not in roots:
        raise LookupError("ops is not a registered project; run `tasks init` in the ops checkout")
    return pathlib.Path(os.path.expanduser(roots["ops"]))


def staged(path):
    """The staged content of `path`; None when it is not part of this commit.

    A staged deletion (or the old side of a rename) is listed by `--name-only` but has
    no index entry to show, so it raises rather than being mistaken for "not staged"."""
    names = subprocess.run(["git", "diff", "--cached", "--name-only", "--", path],
                           check=True, text=True, capture_output=True).stdout.split()
    if not names:
        return None
    shown = subprocess.run(["git", "show", f":{path}"], text=True, capture_output=True)
    if shown.returncode:
        raise LookupError(f"{path} is staged for deletion or rename; the generated block must stay")
    return shown.stdout


def projects_block():
    try:
        text = staged(TARGET)
    except LookupError as error:
        return fail(str(error))
    if text is None:
        try:
            text = pathlib.Path(TARGET).read_text()
        except OSError as error:
            return fail(str(error))
    try:
        ops = ops_root()
    except LookupError as error:
        return fail(str(error))
    tool = ops / "bin" / "ops-projects"
    if not tool.is_file():
        return fail(f"{tool} not found; the registered ops checkout has no ops-projects")
    rendered = subprocess.run([sys.executable, str(tool), "render"], cwd=ops, text=True,
                              capture_output=True)
    if rendered.returncode:
        return fail(f"ops-projects render failed:\n{rendered.stderr.rstrip()}")
    start, end = text.find(MARK_START), text.find(MARK_END)
    if start < 0 or end < 0 or end < start:
        return fail(f"{TARGET} has no ops:projects markers; the generated block must stay")
    current = text[start:end + len(MARK_END)]
    expected = rendered.stdout.rstrip("\n")
    if current == expected or current == expected.replace(PREVIOUS_MARK_START, MARK_START, 1):
        return 0
    diff = difflib.unified_diff(expected.splitlines(), current.splitlines(),
                                "ops-projects render", TARGET, lineterm="")
    sys.stderr.write("\n".join(diff) + "\n")
    return fail(f"the projects block in {TARGET} differs from ops-projects render — either "
                "it was edited by hand, or identity.toml in some project or identity-mirror.toml "
                "in ops changed and `just projects` has not been run in ops; declared fields are "
                "edited in the project's identity.toml, the rest in the mirror")


if __name__ == "__main__":
    sys.exit(projects_block())
